<UserControl x:Class="FlightCareer.UI.Utils.FlightMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#15181C" CornerRadius="10" ClipToBounds="True" BorderBrush="#2D3033" BorderThickness="1">
        <Grid>
            <gmap:GMapControl x:Name="MainMap" MouseRightButtonDown="MainMap_MouseRightButtonDown"/>

            <!-- Atribuição Obrigatória (ESRI/ArcGIS) -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                    Background="#AA000000" Padding="5,2" Margin="5" CornerRadius="3" IsHitTestVisible="False">
                <TextBlock Text="© Esri, OpenStreetMap contributors" FontSize="8" Foreground="White" Opacity="0.6"/>
            </Border>
            
            <!-- Overlay para informações de distância dos waypoints -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" 
                    Background="#CC0F1113" CornerRadius="5" Padding="8,4" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="TxtDistance" Text="0.0 NM" FontSize="12" FontWeight="Bold" Foreground="#2ECC71"/>
                    <TextBlock Text="WAYPOINTS ACTIVE" FontSize="8" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Botão para limpar waypoints -->
            <Button VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"
                    Content="LIMPAR" Click="BtnClear_Click" FontSize="9" Padding="8,2"
                    Background="#2D3033" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
