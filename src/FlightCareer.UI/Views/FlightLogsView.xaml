<UserControl x:Class="FlightCareer.UI.Views.FlightLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utils="clr-namespace:FlightCareer.UI.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- CABEÇALHO -->
            <RowDefinition Height="*"/>    <!-- CORPO SPLIT-SCREEN (32% / 68%) -->
        </Grid.RowDefinitions>

        <!-- CABEÇALHO DA TELA DE LOGS -->
        <Border Grid.Row="0" Background="#141C24" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderBrush="#263545" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Diário de Bordo &amp; Blackbox" FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Inter, Segoe UI, sans-serif"/>
                        <Border Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalFlightsCount, StringFormat='{}{0} voos gravados'}" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Histórico completo de telemetria gravada segundo a segundo com reconstituição de rota em mapa" FontSize="11" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Campo de Busca -->
                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" Width="200">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
                    </Border>

                    <Button Command="{Binding RefreshLogsCommand}" Height="34" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#00E5FF" Cursor="Hand" Padding="10,0" Margin="0,0,8,0" ToolTip="Atualizar lista de logs">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="ATUALIZAR" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding OpenLogsFolderCommand}" Height="34" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#F0F4F8" Cursor="Hand" Padding="10,0" ToolTip="Abrir pasta de arquivos no Windows Explorer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📂 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="PASTA DE LOGS" FontSize="11.5" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CORPO SPLIT-SCREEN -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32*"/> <!-- LISTA DE VOOS -->
                <ColumnDefinition Width="68*"/> <!-- DETALHES + MAPA + TELEMETRIA -->
            </Grid.ColumnDefinitions>

            <!-- PAINEL ESQUERDO: LISTA DE VOOS GRAVADOS -->
            <Border Grid.Column="0" Background="#141C24" CornerRadius="8" Padding="12" Margin="0,0,10,0" BorderBrush="#263545" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MISSÕES &amp; VOOS ARQUIVADOS" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FlightLogs}" SelectedItem="{Binding SelectedLog}" 
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="10,8" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1A2836"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Linha 1: Rota e Badge de Status -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding RouteDisplay}" FontSize="14" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        <Border HorizontalAlignment="Right" Background="{Binding StatusBg}" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </Border>
                                    </Grid>

                                    <!-- Linha 2: Aeronave e Data -->
                                    <Grid Grid.Row="1" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✈ " FontSize="11" Foreground="#8B9BAE" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Aircraft}" FontSize="12" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DateFormatted}" HorizontalAlignment="Right" FontSize="11.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    </Grid>

                                    <!-- Linha 3: Duração e Rating -->
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Duração: " FontSize="11" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding DurationFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding QualityRating}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{Binding QualityColor}" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- PAINEL DIREITO: DETALHES COMPLETOS, MAPA DE ROTA E TELEMETRIA -->
            <Border Grid.Column="1" Background="#141C24" CornerRadius="8" Padding="14" BorderBrush="#263545" BorderThickness="1">
                <Grid>
                    <!-- Se nenhum voo selecionado -->
                    <Border Background="#0B0F14" CornerRadius="8" Padding="30"
                            Visibility="{Binding HasSelectedLog, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="NENHUM VOO SELECIONADO" FontSize="15" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecione um voo da lista à esquerda para analisar a telemetria gravada e visualizar o traçado de rota no mapa." FontSize="12.5" Foreground="#8B9BAE" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Se voo selecionado -->
                    <Grid Visibility="{Binding HasSelectedLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- KPIs / Banner Superior -->
                            <RowDefinition Height="1.2*"/> <!-- Mapa de Trajetória Interativo -->
                            <RowDefinition Height="1.0*"/> <!-- Tabela de Telemetria Blackbox -->
                            <RowDefinition Height="Auto"/> <!-- Barra de Ações Inferior -->
                        </Grid.RowDefinitions>

                        <!-- 1. KPIS E BANNER DE PERFORMANCE -->
                        <Border Grid.Row="0" Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Identificação Principal -->
                                <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedLog.RouteDisplay}" FontSize="18" FontWeight="Black" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        <Border Background="{Binding SelectedLog.StatusBg}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedLog.StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedLog.StatusColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedLog.DateFormatted}" FontSize="12" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Métricas Rápidas (UniformGrid) -->
                                <UniformGrid Grid.Column="1" Columns="5" VerticalAlignment="Center">
                                    <Border Background="#141C24" CornerRadius="4" Padding="8,5" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="DURAÇÃO" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding SelectedLog.DurationFormatted}" FontSize="13.5" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141C24" CornerRadius="4" Padding="8,5" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="TOUCHDOWN" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding SelectedLog.TouchdownDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="#00E676" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141C24" CornerRadius="4" Padding="8,5" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="QUALIDADE" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding SelectedLog.QualityRating}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding SelectedLog.QualityColor}" FontFamily="Inter, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141C24" CornerRadius="4" Padding="8,5" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="FORÇA G" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding SelectedLog.GForceRange}" FontSize="13.5" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141C24" CornerRadius="4" Padding="8,5" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="ALTITUDE MÁX" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding SelectedLog.MaxAltitudeFt, StringFormat={}{0:N0} FT}" FontSize="13.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- 2. MAPA DE TRAJETÓRIA REAL (ROTA DE TELEMETRIA) -->
                        <Border Grid.Row="1" Background="#0B0F14" CornerRadius="6" ClipToBounds="True" BorderBrush="#263545" BorderThickness="1" Margin="0,0,0,10">
                            <Grid>
                                <utils:FlightMapControl RecordedPath="{Binding SelectedLog.MapRoutePoints}"
                                                        OriginIcao="{Binding SelectedLog.OriginICAO}"
                                                        DestIcao="{Binding SelectedLog.DestinationICAO}"/>
                                
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E60B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗺️ TRAJETÓRIA REAL DE VOO • " FontSize="11" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                        <TextBlock Text="{Binding SelectedLog.MapRoutePoints.Count, StringFormat='{}{0} PONTOS GPS'}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 3. TABELA DE TELEMETRIA BLACKBOX SEGUNDO A SEGUNDO -->
                        <Border Grid.Row="2" Background="#0B0F14" CornerRadius="6" BorderBrush="#263545" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="4,0,4,6">
                                    <TextBlock Text="REGISTRO DETALHADO DE TELEMETRIA (AMOSTRAGEM 2s)" FontSize="11" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <TextBlock Text="{Binding SelectedLog.TelemetryRecords.Count, StringFormat='{}{0} REGISTROS'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedLog.TelemetryRecords}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#081018"
                                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A2836"
                                          HeadersVisibility="Column" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="11.5">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#141C24"/>
                                            <Setter Property="Foreground" Value="#8B9BAE"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="6,5"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="BorderBrush" Value="#263545"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TEMPO" Binding="{Binding ElapsedFormatted}" Width="75"/>
                                        <DataGridTextColumn Header="ALT (FT)" Binding="{Binding AltitudeFt, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="GS (KT)" Binding="{Binding GroundSpeedKt, StringFormat={}{0:N0}}" Width="75"/>
                                        <DataGridTextColumn Header="VS (FPM)" Binding="{Binding VerticalSpeedFpm, StringFormat={}{0:N0}}" Width="85"/>
                                        <DataGridTextColumn Header="G-FORCE" Binding="{Binding GForce, StringFormat={}{0:F2}}" Width="75"/>
                                        <DataGridTextColumn Header="RPM" Binding="{Binding EngineRPM, StringFormat={}{0:N0}}" Width="75"/>
                                        <DataGridTextColumn Header="COMB (GAL)" Binding="{Binding FuelGallons, StringFormat={}{0:F1}}" Width="85"/>
                                        <DataGridTextColumn Header="FASE / STATUS" Binding="{Binding Status}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 4. BARRA DE AÇÕES INFERIOR -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Arquivo: " FontSize="11.5" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                <TextBlock Text="{Binding SelectedLog.FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding OpenCsvFileCommand}" Height="36" Background="#1F2B37" BorderBrush="#00E5FF" BorderThickness="1" Foreground="#00E5FF" Cursor="Hand" Padding="14,0" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📊 " FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ABRIR NO EXCEL (CSV)" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Command="{Binding OpenLogsFolderCommand}" Height="36" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#F0F4F8" Cursor="Hand" Padding="14,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📂 " FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ABRIR PASTA" FontSize="11.5" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
