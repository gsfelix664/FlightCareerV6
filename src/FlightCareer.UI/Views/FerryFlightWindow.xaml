<Window x:Class="FlightCareer.UI.Views.FerryFlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voo de Translado / Ferry" Height="680" Width="820"
        Background="#0F1113" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="#2D3033" BorderThickness="1" CornerRadius="16" Background="#0F1113">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✈️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VOO DE TRANSLADO &amp; REPOSICIONAMENTO (FERRY)" FontSize="18" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}"/>
                    </StackPanel>
                    <TextBlock Text="Repositione sua aeronave para qualquer aeródromo do mundo sem travar sua carreira." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="28,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="Close_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" FontSize="16" FontWeight="Bold" Content="✕" Width="30" Height="30"/>
            </Grid>

            <!-- Painel de Seleção e Busca de Aeroporto -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Origem -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="LOCALIZAÇÃO ATUAL (ORIGEM)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding OriginIcao}" FontSize="22" FontWeight="Black" Foreground="#2ECC71" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding OriginAirportName}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OriginLocation}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding AircraftPrefix, StringFormat={}Aeronave: {0}}" FontSize="10" Foreground="#F59E0B" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Ícone Seta -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="➔" FontSize="24" Foreground="#4B5563" VerticalAlignment="Center" Margin="20,0,20,0"/>

                    <!-- Destino com Busca -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="DESTINO DESEJADO (QUALQUER AEROPORTO)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#111315" Foreground="White" BorderBrush="#374151" BorderThickness="1" 
                                     Padding="10,6" FontSize="13" FontWeight="Bold" CharacterCasing="Upper">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchDestinationCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SearchDestinationCommand}" Content="BUSCAR ICAO" 
                                    Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Bold" FontSize="11" 
                                    Padding="14,6" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                        </Grid>
                        <TextBlock Text="{Binding DestinationLocation}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Mensagem de Status -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Cards de Opções: Voo Real vs Pular -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Opção 1: Voar de Verdade no Simulador -->
                <Border Grid.Column="0" Background="#161B22" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Background="#1E3A8A" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="RECOMENDADO • VOAR NO SIMULADOR" FontSize="9" FontWeight="Bold" Foreground="#93C5FD"/>
                            </Border>
                            <TextBlock Text="Opção 1: Voo Manual (Você no Manche)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Decole no MSFS e voe a rota completa até o destino." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,12"/>
                        </StackPanel>

                        <Separator Grid.Row="1" Background="#262D35" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Distância Estimada" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding DistanceNM, StringFormat={}{0:F0} NM}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Tempo Estimado de Voo" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding EstimatedHours, StringFormat={}{0:F1} horas}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Consumo Estimado" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding EstimatedFuelGallons, StringFormat={}{0:F1} GAL}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Custo Direto (Combustível)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding DirectFuelCost, StringFormat={}{0:C2}}" FontSize="14" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#111827" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="✓ Acumula horas no Logbook e perfil do piloto" FontSize="10" Foreground="#2ECC71" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="✓ Ganho integral de XP com base na distância" FontSize="10" Foreground="#2ECC71" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="✓ Gera rota no Briefing e mapa de navegação" FontSize="10" Foreground="#2ECC71" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="3" Command="{Binding SetupRealFlightCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding HasValidDestination}" Background="{StaticResource PrimaryBlue}" Foreground="White" 
                                FontWeight="Bold" FontSize="12" Height="42" Cursor="Hand" BorderThickness="0" Margin="0,14,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Opacity="{TemplateBinding IsEnabled, Converter={StaticResource InverseBooleanToOpacityConverter}}">
                                        <TextBlock Text="GERAR VOO NO BRIEFING" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Opção 2: Translado Imediato (Pular) -->
                <Border Grid.Column="1" Background="#161B22" BorderBrush="#B45309" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Background="#78350F" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="CONTRATAR PILOTO • TRANSLADO IMEDIATO" FontSize="9" FontWeight="Bold" Foreground="#FDE68A"/>
                            </Border>
                            <TextBlock Text="Opção 2: Pular Imediatamente" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Reposiciona a aeronave e piloto sem voar no simulador." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,12"/>
                        </StackPanel>

                        <Separator Grid.Row="1" Background="#262D35" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Combustível Translado (Margem)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding DirectFuelCost, StringFormat={}{0:C2}}" FontSize="11" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Diária Piloto Comercial Ferry" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding JumpPilotFee, StringFormat={}{0:C2}}" FontSize="11" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Taxas de Despacho &amp; Solo" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding JumpHandlingFee, StringFormat={}{0:C2}}" FontSize="11" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#231A12" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="CUSTO TOTAL PARA PULAR" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                    <TextBlock Text="{Binding TotalJumpCost, StringFormat={}{0:C2}}" FontSize="20" FontWeight="Black" Foreground="#F59E0B" Margin="0,2,0,4"/>
                                    <TextBlock Text="⚠ Custo superior ao voo real para cobrir custos de tripulação terceirizada e incentivar a simulação de voo." FontSize="9" Foreground="#D97706" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="✗ NÃO concede horas de voo para o piloto" FontSize="10" Foreground="#EF4444" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="✗ NÃO concede pontos de experiência (XP)" FontSize="10" Foreground="#EF4444" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="• Aplica o desgaste de horas na célula e TBO do avião" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="3" Command="{Binding ExecuteInstantJumpCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding CanAffordJump}" Background="#D97706" Foreground="White" 
                                FontWeight="Bold" FontSize="12" Height="42" Cursor="Hand" BorderThickness="0" Margin="0,14,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Opacity="{TemplateBinding IsEnabled, Converter={StaticResource InverseBooleanToOpacityConverter}}">
                                        <TextBlock Text="PAGAR E REPOSICIONAR AGORA" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Rodapé / Saldo Atual -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Saldo Disponível na Empresa: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding PilotBalance, StringFormat={}{0:C2}}" FontSize="13" FontWeight="Bold" Foreground="#2ECC71"/>
                </StackPanel>
                <Button Grid.Column="1" Content="FECHAR" Click="Close_Click" Cursor="Hand" Background="#222529" Foreground="White" FontWeight="Bold" FontSize="11" Padding="18,8" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
