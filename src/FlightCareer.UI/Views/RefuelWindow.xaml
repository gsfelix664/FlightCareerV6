<Window x:Class="FlightCareer.UI.Views.RefuelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posto de Combustível" Height="450" Width="400"
        Background="#0F1113" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border BorderBrush="#2D3033" BorderThickness="1" CornerRadius="15" Background="#0F1113">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="ABASTECIMENTO" FontSize="20" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}"/>
                <TextBlock Text="{Binding FuelType}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COTAÇÃO DIÁRIA" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding PricePerGallon, StringFormat={}{0:C2} / GAL}" FontSize="20" FontWeight="Bold" Foreground="#F1C40F" FontFamily="JetBrains Mono, Consolas, monospace"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#F1C40F" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </Border>

                <TextBlock Text="QUANTIDADE DESEJADA" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="{Binding CurrentFuel, StringFormat={}{0:F1} GAL}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                    <TextBlock Text="{Binding TargetFuel, StringFormat={}{0:F1} GAL}" FontSize="15" FontWeight="Black" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas, monospace"/>
                </Grid>
                <Slider Minimum="0" Maximum="{Binding MaxFuel}" Value="{Binding TargetFuel}" Margin="0,0,0,20"/>

                <Separator Background="#2D3033" Margin="0,0,0,20"/>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOTAL A PAGAR" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat={}{0:C2}}" FontSize="26" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BalanceInfo}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>

            <UniformGrid Grid.Row="2" Columns="2" Margin="0,20,0,0">
                <Button Content="CANCELAR" Click="Cancel_Click" Style="{StaticResource NavButton}" Background="#1A1C1E" Margin="0,0,5,0" HorizontalContentAlignment="Center"/>
                <Button Content="CONFIRMAR" Command="{Binding ConfirmRefuelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Bold" Height="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>