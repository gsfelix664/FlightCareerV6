<Window x:Class="FlightCareer.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading Flight Career" Height="300" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#0F1113" CornerRadius="20" BorderBrush="#1A1C1E" BorderThickness="1">
        <Grid Margin="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FLIGHT CAREER" Foreground="#00A3FF" FontSize="36" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="VIRTUAL AVIATION SYSTEM" Foreground="#4B5563" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,50"/>
                
                <TextBlock x:Name="StatusLabel" Text="Iniciando sistemas..." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <ProgressBar x:Name="ProgressBar" Height="2" Background="#1A1C1E" Foreground="#00A3FF" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
