<Window x:Class="FlightCareer.UI.Views.CreatePilotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entities="clr-namespace:FlightCareer.Domain.Entities;assembly=FlightCareer.Domain"
        Title="Novo Piloto" Height="500" Width="400"
        Background="#0F1113" Foreground="#E1E2E5" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D3033"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="CRIAR CARREIRA" FontSize="24" FontWeight="Black" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock Text="Inicie sua jornada na aviação virtual" FontSize="12" Foreground="#6B7280" Margin="0,0,0,30"/>

            <TextBlock Text="NOME DO PILOTO" FontSize="10" FontWeight="Bold" Foreground="#00A3FF" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40"/>

            <TextBlock Text="NOME DA COMPANHIA" FontSize="10" FontWeight="Bold" Foreground="#00A3FF" Margin="0,20,0,5"/>
            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40"/>

            <TextBlock Text="ICAO BASE INICIAL" FontSize="10" FontWeight="Bold" Foreground="#00A3FF" Margin="0,20,0,5"/>
            <TextBox Text="{Binding InitialBaseICAO, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40" MaxLength="4" CharacterCasing="Upper"/>

            <TextBlock Text="DIFICULDADE" FontSize="10" FontWeight="Bold" Foreground="#00A3FF" Margin="0,20,0,5"/>
            <ComboBox SelectedValue="{Binding SelectedDifficulty}" Style="{StaticResource ModernComboBox}">
                <entities:DifficultyMode>Easy</entities:DifficultyMode>
                <entities:DifficultyMode>Medium</entities:DifficultyMode>
                <entities:DifficultyMode>Hard</entities:DifficultyMode>
            </ComboBox>

            <Border Background="#1000A3FF" CornerRadius="8" Padding="15" Margin="0,30,0,0">
                <TextBlock Text="* Sua carreira começará com um Cessna 152 no hangar e saldo ajustado pela dificuldade." 
                           FontSize="11" Foreground="#00A3FF" TextWrapping="Wrap" FontStyle="Italic"/>
            </Border>

            <Button Content="INICIAR CARREIRA" Command="{Binding CreateCommand}" 
                    Height="50" Background="#00A3FF" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,30,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0086D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
