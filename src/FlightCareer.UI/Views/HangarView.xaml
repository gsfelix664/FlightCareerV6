<UserControl x:Class="FlightCareer.UI.Views.HangarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <!-- Paleta Avionics Dark (igual ao resto do app) -->
        <SolidColorBrush x:Key="HgBase" Color="#0B0F14"/>
        <SolidColorBrush x:Key="HgSurface" Color="#141C24"/>
        <SolidColorBrush x:Key="HgHover" Color="#1F2B37"/>
        <SolidColorBrush x:Key="HgBorder" Color="#263545"/>
        <SolidColorBrush x:Key="HgText" Color="#F0F4F8"/>
        <SolidColorBrush x:Key="HgText2" Color="#8B9BAE"/>
        <SolidColorBrush x:Key="HgMuted" Color="#526375"/>
        <SolidColorBrush x:Key="HgCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="HgGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="HgAmber" Color="#FFB300"/>
        <SolidColorBrush x:Key="HgRed" Color="#FF5252"/>
        <FontFamily x:Key="HgMono">JetBrains Mono, Consolas, monospace</FontFamily>
        <FontFamily x:Key="HgSans">Inter, Segoe UI, sans-serif</FontFamily>

        <Style x:Key="HgCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HgSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="HgCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HgText2}"/>
            <Setter Property="FontFamily" Value="{StaticResource HgSans}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="HgLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HgText2}"/>
            <Setter Property="FontFamily" Value="{StaticResource HgSans}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="HgValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HgText}"/>
            <Setter Property="FontFamily" Value="{StaticResource HgMono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Botões -->
        <Style x:Key="HgButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource HgText}"/>
            <Setter Property="Background" Value="{StaticResource HgHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HgBorder}"/>
            <Setter Property="FontFamily" Value="{StaticResource HgSans}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HgPrimary" TargetType="Button" BasedOn="{StaticResource HgButtonBase}">
            <Setter Property="Background" Value="{StaticResource HgCyan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HgCyan}"/>
            <Setter Property="Foreground" Value="{StaticResource HgBase}"/>
        </Style>
        <Style x:Key="HgSecondary" TargetType="Button" BasedOn="{StaticResource HgButtonBase}"/>
        <Style x:Key="HgDanger" TargetType="Button" BasedOn="{StaticResource HgButtonBase}">
            <Setter Property="Background" Value="{StaticResource HgRed}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HgRed}"/>
            <Setter Property="Foreground" Value="{StaticResource HgBase}"/>
        </Style>

        <!-- Chip de informação do cabeçalho -->
        <Style x:Key="HgChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HgBase}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource HgBase}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= FROTA ================= -->
        <Border Grid.Column="0" Background="{StaticResource HgSurface}" BorderBrush="{StaticResource HgBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource HgBorder}" BorderThickness="0,0,0,1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="MINHA FROTA" Foreground="{StaticResource HgText}" FontFamily="{StaticResource HgSans}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FleetCountText}" Style="{StaticResource HgLabel}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Fleet}" SelectedItem="{Binding SelectedAircraft}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="item" Padding="16,12" BorderBrush="{StaticResource HgBorder}" BorderThickness="0,0,0,1" Background="Transparent" Cursor="Hand">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Prefix}" Foreground="{StaticResource HgText}" FontFamily="{StaticResource HgMono}" FontWeight="Bold" FontSize="14"/>
                                                        <Border Background="{StaticResource HgBase}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Location}" Foreground="{StaticResource HgCyan}" FontFamily="{StaticResource HgMono}" FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource HgGreen}" CornerRadius="3" Padding="6,1"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="ATIVA" Foreground="{StaticResource HgBase}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource HgMono}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Model}" Foreground="{StaticResource HgText2}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,6"/>
                                                <Grid Height="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding AirworthinessFill}"/>
                                                        <ColumnDefinition Width="{Binding AirworthinessEmpty}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="2" Background="{StaticResource HgBase}" CornerRadius="2.5"/>
                                                    <Border Grid.Column="0" Background="{Binding AirworthinessBrush}" CornerRadius="2.5"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource HgMono}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="item" Property="Background" Value="{StaticResource HgHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="item" Property="Background" Value="{StaticResource HgHover}"/>
                                                <Setter TargetName="item" Property="BorderBrush" Value="{StaticResource HgCyan}"/>
                                                <Setter TargetName="item" Property="BorderThickness" Value="3,0,0,1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= AERONAVE SELECIONADA ================= -->
        <Grid Grid.Column="1" Margin="24,20,24,0" DataContext="{Binding SelectedAircraft}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Prefix}" Foreground="{StaticResource HgText}" FontFamily="{StaticResource HgMono}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Model}" Foreground="{StaticResource HgText2}" FontFamily="{StaticResource HgSans}" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource HgSecondary}" Margin="0,0,8,0" Content="✈  VOO DE TRANSLADO"
                                Command="{Binding DataContext.OpenFerryWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Planejar voo de translado para reposicionar a aeronave"/>
                        <Button Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HgPrimary}">
                                    <Setter Property="Content" Value="DEFINIR COMO ATIVA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Content" Value="✓ AERONAVE ATIVA"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HgGreen}"/>
                                            <Setter Property="Foreground" Value="{StaticResource HgGreen}"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="LOCAL " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding Location}" Style="{StaticResource HgValue}" Foreground="{StaticResource HgCyan}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="MOTOR " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding EngineClassText}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="CÉLULA " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding AirframeHours, StringFormat={}{0:N1} h}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="POUSOS " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding LandingsCount}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="PAX " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding MaxPax}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="CRUZEIRO " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding CruiseSpeedKts, StringFormat={}{0} kt}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="ALCANCE " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding RangeNM, StringFormat={}{0} nm}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="MTOW " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding MTOW, StringFormat={}{0:N0} lbs}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource HgChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="CABINE " Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding Configuration}" Style="{StaticResource HgValue}"/></StackPanel></Border>
                </WrapPanel>

                <!-- Status -->
                <Border Background="{StaticResource HgSurface}" BorderBrush="{Binding StatusBrush}" BorderThickness="4,1,1,1" CornerRadius="6" Padding="14,10" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontFamily="{StaticResource HgMono}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource HgText2}" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Conteúdo -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="420"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">

                    <!-- ===== Panes em aberto (discrepâncias persistentes) ===== -->
                    <Border Style="{StaticResource HgCard}" BorderBrush="{StaticResource HgRed}" Margin="0,0,0,16"
                            Visibility="{Binding HasOpenDefects, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PANES EM ABERTO" Style="{StaticResource HgCardTitle}" Foreground="{StaticResource HgRed}" Margin="0"/>
                                <Button Style="{StaticResource HgDanger}" Content="{Binding RepairAllDefectsText}" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.RepairAllDefectsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HgLabel}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Text="Panes ficam no avião entre voos e após reiniciar o simulador. NO-GO impede o voo; DIFERIDA permite voar com o item inoperante."/>
                            <ItemsControl ItemsSource="{Binding OpenDefects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource HgBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource HgAmber}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGrounding}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HgRed}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding SeverityLabel}" Foreground="{StaticResource HgBase}" FontFamily="{StaticResource HgMono}" FontWeight="Bold" FontSize="10.5"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource HgValue}" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource HgLabel}" FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="{Binding OriginLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FlightPhase, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Cause, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource HgSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Content="{Binding RepairCost, StringFormat='Reparar · {0:C0}'}"
                                                        Command="{Binding DataContext.RepairDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== Componentes ===== -->
                    <Border Style="{StaticResource HgCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="COMPONENTES" Style="{StaticResource HgCardTitle}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource HgSecondary}" Content="Walkaround" Margin="0,0,8,0"
                                            Command="{Binding DataContext.WalkaroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding CanService}"
                                            ToolTip="Inspeção visual grátis: estima pneus, freios, trem, óleo e célula com ±10%"/>
                                    <Button Style="{StaticResource HgPrimary}" Content="{Binding RepairAllText}" IsEnabled="{Binding HasRepairs}"
                                            Command="{Binding DataContext.RepairAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Resumo -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource HgBase}" CornerRadius="6" Padding="12,8" Margin="0,0,6,0"
                                        ToolTip="Pior componente crítico: decide alertas e risco de pane">
                                    <StackPanel>
                                        <TextBlock Text="AERONAVEGABILIDADE" Style="{StaticResource HgLabel}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AirworthinessText}" Style="{StaticResource HgValue}" FontSize="18" Foreground="{Binding AirworthinessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource HgBase}" CornerRadius="6" Padding="12,8" Margin="6,0,0,0"
                                        ToolTip="Média ponderada de todos os componentes: decide o valor de mercado">
                                    <StackPanel>
                                        <TextBlock Text="CONDIÇÃO GERAL" Style="{StaticResource HgLabel}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ConditionText}" Style="{StaticResource HgValue}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Legenda -->
                            <TextBlock Style="{StaticResource HgLabel}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Text="Faixa clara = estimativa (ainda não inspecionado). Marcas em 20% e 30%: abaixo de 30% surgem sintomas; abaixo de 20% há risco de pane."/>

                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource HgBorder}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource HgText}" FontFamily="{StaticResource HgSans}" FontWeight="SemiBold" FontSize="13"/>
                                                            <Border Background="{StaticResource HgBase}" CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsCritical, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    ToolTip="Componente crítico: entra na aeronavegabilidade">
                                                                <TextBlock Text="CRÍTICO" Foreground="{StaticResource HgText2}" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource HgMono}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RangeText}" HorizontalAlignment="Right" Foreground="{Binding Brush}" FontFamily="{StaticResource HgMono}" FontWeight="Bold" FontSize="13"/>
                                                    </Grid>

                                                    <!-- Barra com faixa oculta e marcas de 20% / 30% -->
                                                    <Grid Height="9" Margin="0,6,0,5">
                                                        <Border Background="{StaticResource HgBase}" CornerRadius="4.5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding FillWidth}"/>
                                                                <ColumnDefinition Width="{Binding BandWidth}"/>
                                                                <ColumnDefinition Width="{Binding EmptyWidth}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{Binding Brush}" CornerRadius="4.5,0,0,4.5"/>
                                                            <Border Grid.Column="1" Background="{Binding Brush}" Opacity="0.3"/>
                                                        </Grid>
                                                        <Grid IsHitTestVisible="False">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20*"/>
                                                                <ColumnDefinition Width="10*"/>
                                                                <ColumnDefinition Width="70*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="1" BorderBrush="#99FF5252" BorderThickness="1,0,0,0"/>
                                                            <Border Grid.Column="2" BorderBrush="#99FFB300" BorderThickness="1,0,0,0"/>
                                                        </Grid>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LifeText}" Foreground="{Binding LifeBrush}" FontSize="11.5"/>
                                                        <TextBlock Text="  ·  " Foreground="{StaticResource HgMuted}" FontSize="11.5"/>
                                                        <TextBlock Text="{Binding VisibilityText}" Foreground="{StaticResource HgMuted}" FontSize="11.5"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="1" Style="{StaticResource HgSecondary}" VerticalAlignment="Center" MinWidth="140"
                                                        Content="{Binding RepairButtonText}" IsEnabled="{Binding CanRepair}"
                                                        Command="{Binding RepairCommand}" CommandParameter="{Binding}"
                                                        ToolTip="{Binding ServiceName}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- ===== Coluna direita ===== -->
                    <StackPanel Grid.Column="2">

                        <!-- Inspeções -->
                        <Border Style="{StaticResource HgCard}">
                            <StackPanel>
                                <TextBlock Text="INSPEÇÕES E REVISÕES" Style="{StaticResource HgCardTitle}"/>

                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Inspeção de 50 h (óleo)" Style="{StaticResource HgLabel}"/>
                                        <TextBlock Text="{Binding HoursUntilNext50hInspection, StringFormat={}{0:F1} h restantes}" Style="{StaticResource HgValue}" Foreground="{Binding Brush50h}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource HgSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding Text50h}" IsEnabled="{Binding CanService}"
                                            Command="{Binding DataContext.Perform50hInspectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Troca de óleo e filtro; revela a saúde exata do motor e do óleo"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Inspeção de 100 h (obrigatória)" Style="{StaticResource HgLabel}"/>
                                        <TextBlock Text="{Binding HoursUntilNext100hInspection, StringFormat={}{0:F1} h restantes}" Style="{StaticResource HgValue}" Foreground="{Binding Brush100h}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource HgSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding Text100h}" IsEnabled="{Binding CanService}"
                                            Command="{Binding DataContext.Perform100hInspectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Inspeção completa: revela a saúde exata de todos os componentes"/>
                                </Grid>

                                <Grid Margin="0,0,0,12" Visibility="{Binding IsPiston, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Revisão de 500 h (magnetos e velas)" Style="{StaticResource HgLabel}"/>
                                        <TextBlock Text="{Binding HoursUntilNext500hInspection, StringFormat={}{0:F1} h restantes}" Style="{StaticResource HgValue}" Foreground="{Binding Brush500h}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource HgSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding Text500h}" IsEnabled="{Binding CanService}"
                                            Command="{Binding DataContext.Perform500hInspectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="TBO do motor" Style="{StaticResource HgLabel}"/>
                                        <TextBlock Text="{Binding EngineTboRemainingHours, StringFormat={}{0:F0} h restantes}" Style="{StaticResource HgValue}" Foreground="{Binding BrushTbo}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource HgSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding TextOverhaul}" IsEnabled="{Binding CanService}"
                                            Command="{Binding DataContext.PerformOverhaulCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding OverhaulTooltip}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Abastecimento -->
                        <Border Style="{StaticResource HgCard}">
                            <StackPanel>
                                <TextBlock Text="ABASTECIMENTO" Style="{StaticResource HgCardTitle}"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Nos tanques" Style="{StaticResource HgLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource HgValue}">
                                        <Run Text="{Binding FuelAmount, StringFormat={}{0:F1}, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding FuelCapacity, StringFormat={}{0:F0} gal, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource HgLabel}">
                                        <Run Text="{Binding FuelType, Mode=OneWay}"/><Run Text=" · preço local"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FuelPricePerGallon, StringFormat={}{0:C2}/gal}" HorizontalAlignment="Right" Style="{StaticResource HgValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Abastecer até" Style="{StaticResource HgLabel}"/>
                                    <TextBlock Text="{Binding TargetFuel, StringFormat={}{0:F1} gal}" HorizontalAlignment="Right" Style="{StaticResource HgValue}" Foreground="{StaticResource HgCyan}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="{Binding FuelCapacity}" Value="{Binding TargetFuel}" Margin="0,0,0,12" IsEnabled="{Binding CanService}"/>
                                <Button Style="{StaticResource HgPrimary}" HorizontalAlignment="Stretch" Content="{Binding RefuelButtonText}" IsEnabled="{Binding CanRefuel}"
                                        Command="{Binding DataContext.RefuelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Seguro -->
                        <Border Style="{StaticResource HgCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="SEGURO" Style="{StaticResource HgCardTitle}" Margin="0"/>
                                    <Border HorizontalAlignment="Right" Background="{Binding InsuranceBrush}" CornerRadius="3" Padding="7,1">
                                        <TextBlock Text="{Binding InsuranceStatusText}" Foreground="{StaticResource HgBase}" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource HgMono}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding InsuranceExpiryText}" Style="{StaticResource HgLabel}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,4"><TextBlock Text="Prêmio (30 dias)" Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding InsurancePremium, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Style="{StaticResource HgValue}"/></Grid>
                                <Grid Margin="0,0,0,4"><TextBlock Text="Cobertura (casco)" Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding InsurancePayout, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Style="{StaticResource HgValue}"/></Grid>
                                <Grid Margin="0,0,0,12"><TextBlock Text="Franquia" Style="{StaticResource HgLabel}"/><TextBlock Text="{Binding InsuranceDeductible, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Style="{StaticResource HgValue}"/></Grid>
                                <Button Style="{StaticResource HgSecondary}" HorizontalAlignment="Stretch" Content="{Binding InsuranceButtonText}" IsEnabled="{Binding CanService}"
                                        Command="{Binding DataContext.BuyInsuranceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Cabine -->
                        <Border Style="{StaticResource HgCard}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CONFIGURAÇÃO DA CABINE" Style="{StaticResource HgCardTitle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Configuration}" Style="{StaticResource HgValue}" Foreground="{StaticResource HgCyan}"/>
                                </StackPanel>
                                <Button Style="{StaticResource HgSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding TextToggleConfiguration}" IsEnabled="{Binding CanService}"
                                        Command="{Binding DataContext.ToggleConfigurationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Perda total -->
            <Border Grid.Row="1" Background="#E60B0F14" CornerRadius="8"
                    Visibility="{Binding IsCrashed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="PERDA TOTAL" FontSize="32" FontWeight="Black" FontFamily="{StaticResource HgMono}" Foreground="{StaticResource HgRed}" HorizontalAlignment="Center"/>
                    <TextBlock Text="A aeronave sofreu danos irreparáveis. Acione o seguro ou descarte-a." FontSize="14" Foreground="{StaticResource HgText}" HorizontalAlignment="Center" Margin="0,10,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource HgPrimary}" Content="ACIONAR SEGURO" Padding="24,10" Margin="0,0,12,0"
                                Command="{Binding DataContext.ClaimInsuranceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Style="{StaticResource HgDanger}" Content="DESCARTAR AERONAVE" Padding="24,10"
                                Command="{Binding DataContext.ScrapAircraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hangar vazio -->
            <TextBlock Grid.RowSpan="2" Text="Nenhuma aeronave no hangar. Compre uma no Mercado." Foreground="{StaticResource HgText2}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
