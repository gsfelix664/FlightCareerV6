<UserControl x:Class="FlightCareer.UI.Views.HangarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <!-- Cores do Tema HTML -->
        <SolidColorBrush x:Key="BgDarker" Color="#0F172A"/>
        <SolidColorBrush x:Key="BgMain" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBg" Color="#334155"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#475569"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>

        <!-- Estilo para os Cards -->
        <Style x:Key="HangarCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgMain}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR: LISTA DE AERONAVES -->
        <Grid Grid.Column="0" Background="{StaticResource BgDarker}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20">
                <TextBlock Text="Minha Frota" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding Fleet}" SelectedItem="{Binding SelectedAircraft}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Padding="15,20" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="Transparent" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Prefix}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                <TextBlock Text="-" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextMain}" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="1" Background="{StaticResource SuccessGreen}" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="ATIVA" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardBg}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="4,0,0,1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER DA AERONAVE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedAircraft.Prefix}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text=" | " FontSize="32" Foreground="{StaticResource BorderColor}" Margin="10,0"/>
                                <TextBlock Text="{Binding SelectedAircraft.Model}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding DataContext.OpenFerryWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Cursor="Hand" Background="#141C24" BorderBrush="#263545" BorderThickness="1" Padding="12,8" Margin="0,0,10,0"
                                        ToolTip="Planejar voo de translado ou reposicionar sua aeronave para outro aeródromo">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✈  " FontSize="12" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                        <TextBlock Text="VOO DE TRANSLADO (FERRY)" FontSize="11.5" FontWeight="Bold" Foreground="#F0F4F8" VerticalAlignment="Center" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                </Button>

                                <Button Padding="15,8" Command="{Binding SetActiveCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Setter Property="Content" Value="Definir como Ativa"/>
                                            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Content" Value="Aeronave Selecionada para Voo"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,15,0,0">
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PAX: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.MaxPax}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MOTOR: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.EngineType}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="VELOCIDADE: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.CruiseSpeedKts, StringFormat={}{0} KT}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ALCANCE: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.RangeNM, StringFormat={}{0} NM}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MTOW: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.MTOW, StringFormat={}{0:N0} LBS}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="COMBUSTÍVEL: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.FuelCapacity, StringFormat={}{0:F0} GAL}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold" Margin="0,0,5,0" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                    <TextBlock Text="{Binding SelectedAircraft.FuelType, StringFormat=({0})}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TBO: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.EngineTboRemainingHours, StringFormat={}{0:F0}h}" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CABINE: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.Configuration}" Foreground="{StaticResource PrimaryBlue}" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{Binding SelectedAircraft.StatusColor}" CornerRadius="6" Padding="12,6">
                                <TextBlock Text="{Binding SelectedAircraft.StatusText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DASHBOARD GRID -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- CARD: PANES EM ABERTO (persistentes; só saem pela oficina) -->
                <Border Style="{StaticResource HangarCard}" Margin="0,0,20,20" BorderBrush="{StaticResource DangerRed}"
                        Visibility="{Binding SelectedAircraft.HasOpenDefects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="⚠️ Panes em Aberto" FontSize="18.5" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                                <TextBlock Text="NO-GO bloqueia missões. Panes diferidas voam, mas são reaplicadas e vigiadas a cada voo." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Command="{Binding RepairAllDefectsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource NavButton}" Background="{StaticResource DangerRed}" Foreground="White" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold"
                                    Content="{Binding SelectedAircraft.DefectsRepairTotal}" ContentStringFormat="Reparar todas ({0:C2})"/>
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SelectedAircraft.OpenDefects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center" Background="#7F1D1D">
                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding OriginLabel, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding FlightPhase, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Cause, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding DataContext.RepairDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="32" Padding="12,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                Content="{Binding RepairCost}" ContentStringFormat="Reparar ({0:C2})"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2">
                    <!-- CARD: MANUTENÇÃO CORRETIVA -->
                    <Border Style="{StaticResource HangarCard}" Margin="0,0,20,20">
                        <StackPanel>
                            <TextBlock Text="🛠️ Manutenção e Reparos" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Motor" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.TargetEngineCondition, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedAircraft.TargetEngineCondition}" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Fuselagem" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.TargetAirframeCondition, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedAircraft.TargetAirframeCondition}" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Pneus" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.TargetTiresCondition, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedAircraft.TargetTiresCondition}" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>

                            <Button Content="Aplicar Reparos" Command="{Binding AuthorizeServicesCommand}" Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Height="45" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD: MANUTENÇÃO REGULATÓRIA & TBO -->
                    <Border Style="{StaticResource HangarCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="📋 Inspeções Regulatórias &amp; TBO" FontSize="18.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

                            <!-- TBO Motor -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TBO Restante do Motor:" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.EngineTboRemainingHours, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="14.5" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </StackPanel>
                                <Button Content="Retífica TBO" Command="{Binding PerformOverhaulCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource NavButton}" Background="#D97706" Foreground="White" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold"
                                        ToolTip="Restaura motor a 100% e TBO para 1.800h"/>
                            </Grid>

                            <!-- Inspeção 50 Horas (Troca de Óleo &amp; Lubrificação) -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Próxima Inspeção 50h (Troca de Óleo):" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedAircraft.HoursUntilNext50hInspection, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="14.5" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        <TextBlock Text=" | Saúde do Óleo: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedAircraft.OilCondition, StringFormat={}{0:F0}%}" Foreground="{Binding SelectedAircraft.OilColor}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Fazer 50h ($850)" Command="{Binding Perform50hInspectionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold"
                                        ToolTip="Troca de óleo mineral/sintético, substituição de filtro e inspeção de limalhas"/>
                            </Grid>

                            <!-- Inspeção 100 Horas -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Próxima Inspeção 100h (Obrigatória):" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.HoursUntilNext100hInspection, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="14.5" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </StackPanel>
                                <Button Content="Fazer 100h ($2.500)" Command="{Binding Perform100hInspectionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold"/>
                            </Grid>

                            <!-- Inspeção 500 Horas (Magnetos & Velas) -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Próxima Inspeção 500h (Magnetos &amp; Velas):" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedAircraft.HoursUntilNext500hInspection, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="14.5" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        <TextBlock Text=" | Saúde: " Foreground="{StaticResource TextMuted}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedAircraft.MagnetosCondition, StringFormat={}{0:F0}%}" Foreground="{Binding SelectedAircraft.MagnetosColor}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Fazer 500h ($1.450)" Command="{Binding Perform500hInspectionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold"
                                        ToolTip="Revisão geral dos magnetos, platinados e troca de velas"/>
                            </Grid>

                            <!-- Configuração de Cabine (Pax vs Carga) -->
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,5,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Configuração da Cabine:" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedAircraft.Configuration}" Foreground="{StaticResource PrimaryBlue}" FontWeight="Bold" FontSize="14.5"/>
                                    </StackPanel>
                                    <Button Content="Converter ($1.200)" Command="{Binding ToggleConfigurationCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource NavButton}" Background="#374151" Foreground="White" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD: ABASTECIMENTO -->
                    <Border Style="{StaticResource HangarCard}" Margin="0,0,20,20">
                        <StackPanel>
                            <TextBlock Text="⛽ Abastecimento" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Combustível:" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAircraft.FuelType}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Preço por Galão:" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAircraft.FuelPricePerGallon, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Nível Atual:" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAircraft.Aircraft.FuelAmount, StringFormat={}{0:F1} gal}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                            </Grid>

                            <StackPanel Margin="0,20,0,0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Abastecer até:" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedAircraft.TargetFuel, StringFormat={}{0:F1} gal}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                </Grid>
                                <Slider Minimum="{Binding SelectedAircraft.Aircraft.FuelAmount}" Maximum="{Binding SelectedAircraft.FuelCapacity}" Value="{Binding SelectedAircraft.TargetFuel}" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedAircraft.RefuelCost, StringFormat={}Custo: {0:C2}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Right" Margin="0,20,0,15"/>
                            
                            <Button Content="Confirmar Abastecimento" Command="{Binding AuthorizeServicesCommand}" Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Height="45" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD: SEGURO -->
                    <Border Style="{StaticResource HangarCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🛡️ Seguro da Aeronave" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Status da Apólice:" Foreground="{StaticResource TextMuted}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="5" Padding="10,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource DangerRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="True">
                                                        <Setter Property="Text" Value="ATIVO"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="False">
                                                        <Setter Property="Text" Value="INATIVO"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Prêmio Mensal:" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAircraft.InsurancePremium, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Valor do Casco (Payout):" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAircraft.InsurancePayout, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,25">
                                <TextBlock Text="Franquia:" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedAircraft.InsuranceDeductible, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                            </Grid>

                            <Button Command="{Binding BuyInsuranceCommand}" Height="45" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="True">
                                                <Setter Property="Content" Value="Seguro Contratado"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="False">
                                                <Setter Property="Content" Value="Contratar Seguro"/>
                                                <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>

            <!-- OVERLAY DE PERDA TOTAL (CRASH) -->
            <Border Grid.Row="1" Background="#CC0F172A" CornerRadius="12" Visibility="{Binding SelectedAircraft.IsCrashed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚠ PERDA TOTAL DETECTADA" FontSize="36" FontWeight="Black" Foreground="{StaticResource DangerRed}" HorizontalAlignment="Center"/>
                    <TextBlock Text="A aeronave sofreu danos estruturais irreparáveis. O seguro deve ser acionado." FontSize="16" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,30"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding ClaimInsuranceCommand}" Content="ACIONAR SEGURO" Style="{StaticResource NavButton}" Background="{StaticResource SuccessGreen}" Foreground="White" FontWeight="Bold" Padding="30,15" Margin="0,0,20,0"/>
                        <Button Command="{Binding ScrapAircraftCommand}" Content="DESCARTAR AERONAVE" Style="{StaticResource NavButton}" Background="{StaticResource DangerRed}" Foreground="White" FontWeight="Bold" Padding="30,15"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
