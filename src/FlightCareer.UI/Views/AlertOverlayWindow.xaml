<Window x:Class="FlightCareer.UI.Views.AlertOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlightCareer - Mensagens"
        Width="460"
        SizeToContent="Height"
        Topmost="True"
        ShowActivated="False"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <ItemsControl ItemsSource="{Binding Toasts}" MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,0,0,8" CornerRadius="6" Background="#E60B1118"
                        BorderBrush="{Binding AccentBrush}" BorderThickness="1,1,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="6,0,0,6"/>

                        <StackPanel Grid.Column="1" Margin="12,10,8,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{Binding AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Foreground="#0B1118" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="{Binding AccentBrush}" FontWeight="Bold" FontSize="13"
                                           FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                <TextBlock Text="{Binding Time}" Foreground="#64748B" FontSize="10.5" Margin="8,0,0,0"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" Foreground="#E2E8F0" FontSize="12.5" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" Margin="26,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Width="28" Height="28" Margin="0,6,6,0" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="13" Cursor="Hand"
                                ToolTip="Fechar"
                                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
