<Window x:Class="FlightCareer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:utils="clr-namespace:FlightCareer.UI.Utils"
        xmlns:views="clr-namespace:FlightCareer.UI.Views"
        mc:Ignorable="d"
        Title="Flight Career V6" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14" Foreground="#F0F4F8"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Estilo BotÃ£o Menu -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="5,2">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="indicator" Width="3" Height="15" Fill="{StaticResource PrimaryBlue}" Visibility="Hidden" Margin="0,0,10,0" RadiusX="1.5" RadiusY="1.5"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3033"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo DataGrid Moderno -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#15181C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Opacity" Value="0.8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,0,10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D3033"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D3033"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2225"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Chip de Filtro (Avionics Dark Mode) -->
        <Style x:Key="ChipFilterButton" TargetType="Button">
            <Setter Property="Background" Value="#141C24"/>
            <Setter Property="Foreground" Value="#8B9BAE"/>
            <Setter Property="BorderBrush" Value="#263545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#F0F4F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tabela Densa de MissÃµes (Dark Mode Avionics) -->
        <Style x:Key="MissionsTableDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#10161D"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#8B9BAE"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
                        <Setter Property="Padding" Value="10,0,10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#263545"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F0F4F8"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F2B37"/>
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#19232D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos de CabeÃ§alho Alinhados para a Tabela de MissÃµes -->
        <Style x:Key="RightAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B9BAE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,0,10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#263545"/>
        </Style>

        <Style x:Key="CenterAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B9BAE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,4,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#263545"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile Info -->
                <StackPanel Grid.Row="0" Margin="10,20,10,35">
                    <TextBlock Text="FLIGHT CAREER" FontSize="20" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,25"/>
                    
                    <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{Binding PilotName}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding PilotCompanyName}" FontSize="13.5" Foreground="{StaticResource PrimaryBlue}" FontWeight="SemiBold" Margin="0,2,0,0"/>

                            <!-- Badge de HomologaÃ§Ã£o da Empresa com AÃ§Ã£o de EvoluÃ§Ã£o -->
                            <Button Command="{Binding PromoteCompanyTierCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,8" HorizontalAlignment="Left" ToolTip="Clique para ver requisitos e categoria operacional da empresa">
                                <Border Background="#161B22" BorderBrush="{Binding CompanyTierColor}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding CompanyTierColor}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CompanyTierBadge}" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text=" â®µ" FontSize="11.5" Foreground="{Binding CompanyTierColor}" FontWeight="Bold" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <TextBlock Text="{Binding RankDisplay}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                            
                            <ProgressBar Height="5" Value="{Binding XpProgress, Mode=OneWay}" Maximum="100" 
                                         Background="#0F1113" Foreground="{StaticResource PrimaryBlue}" BorderThickness="0"/>
                            
                            <TextBlock Text="{Binding CashDisplay}" FontSize="20" FontWeight="Bold" Foreground="#2ECC71" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="OPERAÃ‡Ã•ES" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="15,0,0,10"/>
                    <Button Content="îœ¡  Quadro de MissÃµes" Style="{StaticResource NavButton}" Command="{Binding ShowMissionsCommand}"/>
                    <Button Content="îœ–  Briefing de Voo" Style="{StaticResource NavButton}" Command="{Binding ShowBriefingCommand}"/>
                    <Button Content="îœ¤  Voo de Translado (Ferry)" Style="{StaticResource NavButton}" Command="{Binding OpenFerryWindowCommand}"/>
                    
                    <TextBlock Text="CARREIRA" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="15,25,0,10"/>
                    <Button Content="î´  Mercado de Aeronaves" Style="{StaticResource NavButton}" Command="{Binding ShowMarketCommand}"/>
                    <Button Content="î»  Hangar / Frota" Style="{StaticResource NavButton}" Command="{Binding ShowHangarCommand}"/>
                    <Button Content="î‘  Financeiro" Style="{StaticResource NavButton}" Command="{Binding ShowFinanceCommand}"/>
                    <Button Content="î®  Logs de Voo (Blackbox)" Style="{StaticResource NavButton}" Command="{Binding ShowFlightLogsCommand}"/>

                    <TextBlock Text="FERRAMENTAS &amp; DEBUG" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="15,25,0,10"/>
                    <Button Content="î¨  Debug SimConnect" Style="{StaticResource NavButton}" Command="{Binding ShowDebugCommand}" Foreground="#94A3B8"/>
                    <Button Content="ðŸ–¥ï¸  HUD Overlay (MSFS)" Style="{StaticResource NavButton}" Command="{Binding ShowOverlayCommand}" Foreground="#00E5FF"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="10,0,10,20">
                    <Button Content="îœª  Sair do Perfil" Style="{StaticResource NavButton}" 
                            Foreground="#94A3B8" Click="Button_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Sim Status -->
            <Border Grid.Row="0" Background="#15181C" Padding="30,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{Binding SimStatusColor}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SimStatusText}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#2D3033" Margin="10,0"/>
                        <TextBlock Text="{Binding MonitorStatus}" FontSize="12.5" Foreground="White" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- BotÃ£o de Acesso RÃ¡pido ao HUD Overlay Flutuante -->
                    <Button HorizontalAlignment="Right" Command="{Binding ShowOverlayCommand}" 
                            Background="#141C24" BorderBrush="#00E5FF" BorderThickness="1.2" 
                            Padding="14,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ðŸ–¥ï¸  HUD OVERLAY (MSFS)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- VIEW 1: MISSÕES & CONTRATOS -->
                <views:MissionsView>
                    <views:MissionsView.Style>
                        <Style TargetType="views:MissionsView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Missions">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MissionsView.Style>
                </views:MissionsView>

                <!-- VIEW 2: BRIEFING OPERACIONAL & GATEKEEPER -->
                <views:BriefingView DataContext="{Binding Briefing}">
                    <views:BriefingView.Style>
                        <Style TargetType="views:BriefingView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Briefing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:BriefingView.Style>
                </views:BriefingView>

                <!-- VIEW 3: FINANCEIRO & FLUXO DE CAIXA -->
                <views:FinanceView DataContext="{Binding Finance}">
                    <views:FinanceView.Style>
                        <Style TargetType="views:FinanceView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Finance">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:FinanceView.Style>
                </views:FinanceView>

                <!-- VIEW 4: MERCADO DE AERONAVES -->
                <views:MarketView DataContext="{Binding Market}">
                    <views:MarketView.Style>
                        <Style TargetType="views:MarketView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Market">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MarketView.Style>
                </views:MarketView>

                <!-- VIEW 5: HANGAR & MANUTENÇÃO -->
                <views:HangarView DataContext="{Binding Hangar}">
                    <views:HangarView.Style>
                        <Style TargetType="views:HangarView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Hangar">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:HangarView.Style>
                </views:HangarView>

                <!-- VIEW 6: LOGS DE VOO / BLACKBOX & TELEMETRIA -->
                <views:FlightLogsView DataContext="{Binding FlightLogs}">
                    <views:FlightLogsView.Style>
                        <Style TargetType="views:FlightLogsView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="FlightLogs">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:FlightLogsView.Style>
                </views:FlightLogsView>
            </Grid>
        </Grid>
    </Grid>
</Window>
