<Window x:Class="FlightCareer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:utils="clr-namespace:FlightCareer.UI.Utils"
        mc:Ignorable="d"
        Title="Flight Career V6" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14" Foreground="#F0F4F8"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Estilo Botão Menu -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="5,2">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="indicator" Width="3" Height="15" Fill="{StaticResource PrimaryBlue}" Visibility="Hidden" Margin="0,0,10,0" RadiusX="1.5" RadiusY="1.5"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3033"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo DataGrid Moderno -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#15181C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Opacity" Value="0.8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,0,10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D3033"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D3033"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2225"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Chip de Filtro (Avionics Dark Mode) -->
        <Style x:Key="ChipFilterButton" TargetType="Button">
            <Setter Property="Background" Value="#141C24"/>
            <Setter Property="Foreground" Value="#8B9BAE"/>
            <Setter Property="BorderBrush" Value="#263545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#F0F4F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tabela Densa de Missões (Dark Mode Avionics) -->
        <Style x:Key="MissionsTableDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#10161D"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#8B9BAE"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
                        <Setter Property="Padding" Value="10,0,10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#263545"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F0F4F8"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F2B37"/>
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#19232D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos de Cabeçalho Alinhados para a Tabela de Missões -->
        <Style x:Key="RightAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B9BAE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,0,10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#263545"/>
        </Style>

        <Style x:Key="CenterAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B9BAE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,4,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#263545"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile Info -->
                <StackPanel Grid.Row="0" Margin="10,20,10,40">
                    <TextBlock Text="FLIGHT CAREER" FontSize="18" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,30"/>
                    
                    <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{Binding PilotName}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding PilotCompanyName}" FontSize="12" Foreground="{StaticResource PrimaryBlue}" FontWeight="SemiBold" Margin="0,2,0,0"/>

                            <!-- Badge de Homologação da Empresa com Ação de Evolução -->
                            <Button Command="{Binding PromoteCompanyTierCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,6,0,6" HorizontalAlignment="Left" ToolTip="Clique para ver requisitos e categoria operacional da empresa">
                                <Border Background="#161B22" BorderBrush="{Binding CompanyTierColor}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding CompanyTierColor}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CompanyTierBadge}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text=" ⮵" FontSize="10" Foreground="{Binding CompanyTierColor}" FontWeight="Bold" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <TextBlock Text="{Binding RankDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                            
                            <ProgressBar Height="4" Value="{Binding XpProgress, Mode=OneWay}" Maximum="100" 
                                         Background="#0F1113" Foreground="{StaticResource PrimaryBlue}" BorderThickness="0"/>
                            
                            <TextBlock Text="{Binding CashDisplay}" FontSize="18" FontWeight="Bold" Foreground="#2ECC71" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="OPERAÇÕES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="15,0,0,10"/>
                    <Button Content="  Quadro de Missões" Style="{StaticResource NavButton}" Command="{Binding ShowMissionsCommand}"/>
                    <Button Content="  Briefing de Voo" Style="{StaticResource NavButton}" Command="{Binding ShowBriefingCommand}"/>
                    <Button Content="  Voo de Translado (Ferry)" Style="{StaticResource NavButton}" Command="{Binding OpenFerryWindowCommand}"/>
                    
                    <TextBlock Text="CARREIRA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="15,25,0,10"/>
                    <Button Content="  Mercado de Aeronaves" Style="{StaticResource NavButton}" Command="{Binding ShowMarketCommand}"/>
                    <Button Content="  Hangar / Frota" Style="{StaticResource NavButton}" Command="{Binding ShowHangarCommand}"/>
                    <Button Content="  Financeiro" Style="{StaticResource NavButton}" Command="{Binding ShowFinanceCommand}"/>
                    <Button Content="  Logs de Voo (Blackbox)" Style="{StaticResource NavButton}" Command="{Binding ShowFlightLogsCommand}"/>

                    <TextBlock Text="FERRAMENTAS &amp; DEBUG" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="15,25,0,10"/>
                    <Button Content="  Debug SimConnect" Style="{StaticResource NavButton}" Command="{Binding ShowDebugCommand}" Foreground="#94A3B8"/>
                    <Button Content="🖥️  HUD Overlay (MSFS)" Style="{StaticResource NavButton}" Command="{Binding ShowOverlayCommand}" Foreground="#00E5FF"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="10,0,10,20">
                    <Button Content="  Sair do Perfil" Style="{StaticResource NavButton}" 
                            Foreground="#94A3B8" Click="Button_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Sim Status -->
            <Border Grid.Row="0" Background="#15181C" Padding="30,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{Binding SimStatusColor}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SimStatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#2D3033" Margin="10,0"/>
                        <TextBlock Text="{Binding MonitorStatus}" FontSize="11" Foreground="White" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botão de Acesso Rápido ao HUD Overlay Flutuante -->
                    <Button HorizontalAlignment="Right" Command="{Binding ShowOverlayCommand}" 
                            Background="#141C24" BorderBrush="#00E5FF" BorderThickness="1.2" 
                            Padding="12,5" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️  HUD OVERLAY (MSFS)" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- VIEW: MISSÕES (QUADRO DE CONTRATOS & DESPACHO OPERACIONAL) -->
                <Grid Margin="25">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Missions">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header e Métricas -->
                        <RowDefinition Height="*"/>    <!-- Split-Screen Assimétrico -->
                    </Grid.RowDefinitions>

                    <!-- HEADER SUPERIOR E MÉTRICAS (AVIONICS DARK MODE) -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título e Botão Ferry -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="QUADRO DE MISSÕES &amp; CONTRATOS" FontSize="22" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="#00E676" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentLocation}" FontSize="13.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Command="{Binding OpenFerryWindowCommand}" Cursor="Hand" Background="#141C24" BorderBrush="#263545" BorderThickness="1" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Planejar voo de translado ou reposicionar sua aeronave para outro aeroporto">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✈️ " FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="VOO DE TRANSLADO (FERRY)" FontSize="11.5" FontWeight="Bold" Foreground="#F0F4F8" VerticalAlignment="Center" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1F2B37"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Banner de Métricas Rápidas (Surface Elevada #141C24 com borda #263545) -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                            <Border Background="#141C24" BorderBrush="#263545" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CONTRATOS DISPONÍVEIS" FontSize="11.5" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <TextBlock Text="{Binding FilteredMissions.Count}" FontSize="22" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#141C24" BorderBrush="#263545" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SELECIONADOS EM LOTE" FontSize="11.5" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <TextBlock Text="{Binding SelectedBatchCount}" FontSize="22" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#141C24" BorderBrush="#263545" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="HOMOLOGAÇÃO DA EMPRESA" FontSize="11.5" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <TextBlock Text="{Binding CompanyTierDisplay}" FontSize="15" FontWeight="Bold" Foreground="{Binding CompanyTierColor}" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#141C24" BorderBrush="#263545" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="AEROPORTO DE PARTIDA" FontSize="11.5" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <TextBlock Text="{Binding CurrentAirportICAO}" FontSize="22" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <!-- LAYOUT SPLIT-SCREEN ASSIMÉTRICO (58% ESQUERDA / 42% DIREITA) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58*"/>
                            <ColumnDefinition Width="42*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUNA DA ESQUERDA (58%): FILTROS, BUSCA E TABELA DENSA DE MISSÕES -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Barra Superior de Filtros e Busca -->
                                <RowDefinition Height="*"/>    <!-- Tabela Densa & Empty State -->
                            </Grid.RowDefinitions>

                            <!-- 1. BARRA SUPERIOR DE FILTROS E BUSCA -->
                            <Border Grid.Row="0" Background="#141C24" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#263545" BorderThickness="1">
                                <StackPanel>
                                    <!-- Chips de Filtro por Categoria de Operação -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="TODOS" Command="{Binding SetCategoryFilterCommand}" CommandParameter="TODOS">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="TODOS">
                                                                <Setter Property="Background" Value="#00E5FF"/>
                                                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                                                                <Setter Property="Foreground" Value="#0B0F14"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="TÁXI AÉREO" Command="{Binding SetCategoryFilterCommand}" CommandParameter="TÁXI AÉREO">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="TÁXI AÉREO">
                                                                <Setter Property="Background" Value="#00E676"/>
                                                                <Setter Property="BorderBrush" Value="#00E676"/>
                                                                <Setter Property="Foreground" Value="#0B0F14"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="LINHA REGIONAL" Command="{Binding SetCategoryFilterCommand}" CommandParameter="LINHA REGIONAL">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="LINHA REGIONAL">
                                                                <Setter Property="Background" Value="#00E5FF"/>
                                                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                                                                <Setter Property="Foreground" Value="#0B0F14"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="LINHA REGULAR" Command="{Binding SetCategoryFilterCommand}" CommandParameter="LINHA REGULAR">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="LINHA REGULAR">
                                                                <Setter Property="Background" Value="#00B0FF"/>
                                                                <Setter Property="BorderBrush" Value="#00B0FF"/>
                                                                <Setter Property="Foreground" Value="#0B0F14"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="CARGA / SAE" Command="{Binding SetCategoryFilterCommand}" CommandParameter="CARGA / SAE">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="CARGA / SAE">
                                                                <Setter Property="Background" Value="#FFB300"/>
                                                                <Setter Property="BorderBrush" Value="#FFB300"/>
                                                                <Setter Property="Foreground" Value="#0B0F14"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="INSTRUÇÃO" Command="{Binding SetCategoryFilterCommand}" CommandParameter="INSTRUÇÃO">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="INSTRUÇÃO">
                                                                <Setter Property="Background" Value="#E040FB"/>
                                                                <Setter Property="BorderBrush" Value="#E040FB"/>
                                                                <Setter Property="Foreground" Value="#0B0F14"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="MÉDICA / ESPECIAL" Command="{Binding SetCategoryFilterCommand}" CommandParameter="MÉDICA / ESPECIAL">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFilterButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategoryFilter}" Value="MÉDICA / ESPECIAL">
                                                                <Setter Property="Background" Value="#FF5252"/>
                                                                <Setter Property="BorderBrush" Value="#FF5252"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Linha 2: Busca Rápida + Slider Raio Distância + Checkbox Carga + Reset -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Input Rápido de Busca -->
                                        <Border Grid.Column="0" Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Width="200" Height="36" Margin="0,0,12,0">
                                            <Grid>
                                                <TextBlock Text="🔍" FontSize="12" Foreground="#526375" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" Foreground="#F0F4F8" BorderThickness="0"
                                                         Padding="28,6,6,6" FontSize="12.5" VerticalAlignment="Center"
                                                         FontFamily="Inter, Segoe UI, sans-serif"
                                                         ToolTip="Filtrar por código ICAO ou nome da cidade (ex: SBRJ ou Rio)"/>
                                            </Grid>
                                        </Border>

                                        <!-- Controles de Raio de Distância e Carga -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="RAIO:" FontSize="11.5" FontWeight="Bold" Foreground="#8B9BAE" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            <Slider Minimum="50" Maximum="1000" Value="{Binding MaxDistanceFilter, UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="115" SmallChange="50" LargeChange="100" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MaxDistanceDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center" Margin="8,0,12,0" Width="68"/>

                                            <CheckBox IsChecked="{Binding FilterOnlyCompatiblePayload, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Cursor="Hand">
                                                <CheckBox.Content>
                                                    <TextBlock Text="Carga compatível" FontSize="12.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                </CheckBox.Content>
                                            </CheckBox>
                                        </StackPanel>

                                        <!-- Botão Limpar Filtros & Atualizar METAR -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🔄 METAR" Command="{Binding RefreshMetarsCommand}" ToolTip="Atualizar METARs reais ao vivo da NOAA" Background="#141C24" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Padding="10,5" FontSize="11.5" FontWeight="Bold" Cursor="Hand" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="LIMPAR" Command="{Binding ResetFiltersCommand}" Background="#1F2B37" Foreground="#8B9BAE" BorderBrush="#263545" BorderThickness="1" Padding="10,5" FontSize="11.5" FontWeight="Bold" Cursor="Hand" FontFamily="Inter, Segoe UI, sans-serif">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. TABELA DENSA DE MISSÕES & EMPTY STATE -->
                            <Border Grid.Row="1" Background="#141C24" CornerRadius="8" Padding="8" BorderBrush="#263545" BorderThickness="1">
                                <Grid>
                                    <!-- DataGrid Densa com Tipografia Tabular Monoespaçada e Navegação por ↑ ↓ e Enter -->
                                    <DataGrid ItemsSource="{Binding FilteredMissions}" SelectedItem="{Binding SelectedMissionItem}"
                                              Style="{StaticResource MissionsTableDataGrid}"
                                              PreviewKeyDown="MissionsDataGrid_PreviewKeyDown"
                                              Visibility="{Binding HasFilteredMissions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <!-- Coluna 1: Checkbox para Aceite em Lote -->
                                            <DataGridTemplateColumn Width="34">
                                                <DataGridTemplateColumn.Header>
                                                    <Button Command="{Binding ToggleSelectAllBatchCommand}" ToolTip="Marcar / Desmarcar todos" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                                                        <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#00E5FF"/>
                                                    </Button>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelectedForBatch, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 2: Destino (ICAO em JetBrains Mono + Cidade + Badge MSFS se divergente) -->
                                            <DataGridTemplateColumn Header="DESTINO" Width="135" SortMemberPath="DestinationICAO">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="6,0" ToolTip="{Binding DestinationTooltip}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DestinationICAO}" FontWeight="Bold" FontSize="14" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                <Border Visibility="{Binding HasMsfsAlias, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Background="#102A45" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="3"
                                                                        Padding="5,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MsfsBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DestinationCity}" FontSize="11" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 3: Tipo de Operação com Badge Semântico -->
                                            <DataGridTemplateColumn Header="OPERAÇÃO" Width="105" SortMemberPath="CategoryShortTag">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                            <Border Background="{Binding SemanticBadgeBackground}" BorderBrush="{Binding SemanticBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2.5" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding CategoryShortTag}" FontSize="11" FontWeight="Bold" Foreground="{Binding SemanticTextColor}" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                            </Border>
                                                            <Border Background="#2E1214" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="3" Padding="4,1.5"
                                                                    Visibility="{Binding IsEligibleForPilot, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                                    ToolTip="{Binding IneligibilityReason}">
                                                                <TextBlock Text="🔒" FontSize="9.5" Foreground="#FF5252"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 4: Carga / PAX Formatado (Alinhado à Direita, Largura Ampliada para Não Cortar Textos Longos) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Header="CARGA / PAX" Width="140" SortMemberPath="PayloadLbs">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Center" Margin="4,0,8,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="{Binding PayloadFormatted}" FontWeight="Bold" FontSize="13" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                            <Border Grid.Row="1" Background="#2D220D" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,1,0,0" HorizontalAlignment="Right"
                                                                    Visibility="{Binding IsOverweight, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    ToolTip="Excede a carga útil suportada pela aeronave atual">
                                                                <TextBlock Text="SOBREPESO" FontSize="8.5" FontWeight="Bold" Foreground="#FFB300" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 5: Distância (NM) Tabular (Alinhado à Direita) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Header="DIST (NM)" Width="78" SortMemberPath="DistanceNM">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DistanceNM, StringFormat={}{0:N0} NM}" FontWeight="SemiBold" FontSize="13" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#F0F4F8" Margin="4,0,8,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 6: Rumo / Proa (Heading Inicial, Centralizado) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource CenterAlignedHeader}" Header="RUMO" Width="75" SortMemberPath="HeadingDegrees">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#101722" BorderBrush="#263545" BorderThickness="1" CornerRadius="3" Padding="5,2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding HeadingDisplay}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 7: ETE (Tempo Estimado de Voo, Alinhado à Direita) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Header="ETE" Width="74">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding EteFormatted}" FontWeight="SemiBold" FontSize="13" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#F0F4F8" Margin="4,0,8,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 8: Pista Mínima Requerida (Alinhado à Direita) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Header="PISTA MÍN" Width="78" SortMemberPath="DestTier">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding MinRunwayDisplay}" FontWeight="SemiBold" FontSize="12" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#94A3B8" Margin="4,0,8,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 9: METAR (Meteorologia no Destino, Centralizado) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource CenterAlignedHeader}" Header="METAR" Width="88" SortMemberPath="WeatherCategory">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding WeatherBadgeBg}" BorderBrush="{Binding WeatherBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="6,2.5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding WeatherTooltip}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding WeatherIcon}" FontSize="11" Margin="0,0,3,0"/>
                                                                <TextBlock Text="{Binding WeatherCategory}" FontSize="11" FontWeight="Bold" Foreground="{Binding WeatherColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 10: Expiração do Contrato (Centralizado) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource CenterAlignedHeader}" Header="EXPIRAÇÃO" Width="86" SortMemberPath="ExpirationTime">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding ExpirationBadgeBg}" BorderBrush="{Binding ExpirationBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="5,2.5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ExpirationTooltip}">
                                                            <TextBlock Text="{Binding ExpirationDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding ExpirationColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 11: XP (Alinhado à Direita) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Header="XP" Width="72" SortMemberPath="ExperienceGain">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding XpDisplay}" FontWeight="Bold" FontSize="13" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFB300" Margin="4,0,8,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Coluna 12: Pagamento ($) e Lucro/NM (Largura Flexível *, Alinhado à Direita) -->
                                            <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Header="PAGAMENTO" Width="*" MinWidth="120" SortMemberPath="RewardMoney">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,10,0">
                                                            <TextBlock Text="{Binding RewardMoney, StringFormat=C0}" FontWeight="Bold" FontSize="14.5" Foreground="#00E676" FontFamily="JetBrains Mono, Consolas, monospace" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding ProfitPerNmDisplay}" FontSize="11" Foreground="#8B9BAE" FontFamily="JetBrains Mono, Consolas, monospace" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- EMPTY STATE (Background Base #0B0F14) -->
                                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="8" Padding="30" Margin="10"
                                            Visibility="{Binding HasFilteredMissions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                                            <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#526375"/>
                                            <TextBlock Text="Nenhum Contrato Encontrado" FontSize="15" FontWeight="Bold" Foreground="#F0F4F8" HorizontalAlignment="Center" Margin="0,0,0,6" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            <TextBlock Text="Nenhuma missão encontrada para os filtros atuais. Tente expandir o raio de distância ou alternar os tipos de carga." 
                                                       FontSize="11" Foreground="#8B9BAE" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            <Button Content="RESETAR FILTROS" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" Padding="16,6"
                                                    Background="#1F2B37" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" FontFamily="Inter, Segoe UI, sans-serif" FontWeight="Bold">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- COLUNA DA DIREITA (42%): VIEWPORT DO MAPA TÁTICO, PRÉ-DESPACHO E CTA -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.35*"/> <!-- Viewport do Mapa Tático -->
                                <RowDefinition Height="Auto"/>  <!-- Card de Pré-Despacho Operacional -->
                                <RowDefinition Height="Auto"/>  <!-- CTA Travado no Rodapé -->
                            </Grid.RowDefinitions>

                            <!-- 1. VIEWPORT DE MAPA TÁTICO COM SINCRONIZAÇÃO EM TEMPO REAL -->
                            <Border Grid.Row="0" Background="#141C24" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,10" BorderBrush="#263545" BorderThickness="1">
                                <utils:FlightMapControl AircraftLat="{Binding OriginLat}" AircraftLon="{Binding OriginLon}"
                                                        DestLat="{Binding DestLat}" DestLon="{Binding DestLon}"
                                                        OriginIcao="{Binding CurrentAirportICAO}"
                                                        DestIcao="{Binding SelectedMissionItem.DestinationICAO}"/>
                            </Border>

                            <!-- 2. CARD DE PRÉ-DESPACHO OPERACIONAL & METEOROLOGIA -->
                            <Border Grid.Row="1" Background="#141C24" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#263545" BorderThickness="1">
                                <StackPanel>
                                    <!-- Header do Card de Despacho com H1 Resumo de Rota -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="PRÉ-DESPACHO OPERACIONAL" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" FontFamily="Inter, Segoe UI, sans-serif"/>
                                        </StackPanel>
                                        <!-- H1 Resumo de Rota: 21px Bold Ciano #00E5FF -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CurrentAirportICAO}" FontSize="21" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                            <TextBlock Text=" ➔ " FontSize="18" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedMissionItem.DestinationIcaoWithMsfsNotice, FallbackValue='---'}" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grid de Indicadores: ETE, Consumo e Distância (JetBrains Mono) -->
                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="TEMPO ESTIMADO (ETE)" FontSize="11" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding SelectedMissionItem.EteFormatted, FallbackValue='--'}" FontSize="18" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="2,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="CONSUMO ESTIMADO" FontSize="11" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding SelectedMissionItem.EstimatedFuelGallons, StringFormat={}{0:F1} gal, FallbackValue='--'}" FontSize="15" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    <TextBlock Text="{Binding SelectedMissionItem.EstimatedFuelLbs, StringFormat={} ({0:N0} lbs), FallbackValue=''}" FontSize="11.5" Foreground="#8B9BAE" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="DISTÂNCIA CORREDOR" FontSize="11" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding SelectedMissionItem.DistanceNM, StringFormat={}{0:N0} NM, FallbackValue='0 NM'}" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Card de Situação Operacional / Roleplay (Logo acima do METAR) -->
                                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎯 " FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="SITUAÇÃO OPERACIONAL" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedMissionItem.Title, FallbackValue=''}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFB300" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Chips de Metadados Escaneáveis (Carga/Pax, Pista, Categoria, Regra) -->
                                            <WrapPanel Margin="0,0,0,8">
                                                <Border Background="#161F2A" BorderBrush="#2A3749" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,5,5">
                                                    <TextBlock Text="{Binding SelectedMissionItem.CargoPaxDetailChip, FallbackValue='📦 0 lbs'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                </Border>
                                                <Border Background="#161F2A" BorderBrush="#2A3749" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,5,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🛫 Pista: " FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding SelectedMissionItem.MinRunwayDisplay, FallbackValue='1.500 ft'}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" FontFamily="JetBrains Mono, monospace"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#161F2A" BorderBrush="#2A3749" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,5,5"
                                                        ToolTip="{Binding SelectedMissionItem.RequiredCategoryTooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🎖️ " FontSize="11"/>
                                                        <TextBlock Text="{Binding SelectedMissionItem.RequiredCategoryDisplay, FallbackValue='Cat. 1'}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#161F2A" BorderBrush="{Binding SelectedMissionItem.FlightRulesColor, FallbackValue='#00E5FF'}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,5">
                                                    <TextBlock Text="{Binding SelectedMissionItem.FlightRulesDisplay, FallbackValue='VFR'}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedMissionItem.FlightRulesColor, FallbackValue='#00E5FF'}" FontFamily="JetBrains Mono, monospace"/>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Descrição em Alto Contraste com Tipografia Calibrada -->
                                            <ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding SelectedMissionItem.Description, FallbackValue='Selecione um contrato no quadro para analisar o briefing e a situação operacional.'}" 
                                                           FontSize="13" Foreground="#E2E8F0" FontFamily="Inter, Segoe UI, sans-serif" TextWrapping="Wrap" LineHeight="19"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card de Meteorologia Simplificada (METAR) -->
                                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Badge Categoria VFR / MVFR / IFR -->
                                            <Border Grid.Column="0" Background="{Binding SelectedMissionItem.WeatherColor, FallbackValue='#00E676'}" CornerRadius="3" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedMissionItem.WeatherIcon, FallbackValue='☀️'}" FontSize="12" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SelectedMissionItem.WeatherCategory, FallbackValue='VFR'}" FontSize="11" FontWeight="Bold" Foreground="#0B0F14" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Resumo das Condições Meteorológicas -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="METAR DESTINO (TRANSMISSÃO REAL NOAA)" FontSize="10" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                    <TextBlock Text=" • AO VIVO" FontSize="10" FontWeight="Bold" Foreground="#00E676" FontFamily="Inter, Segoe UI, sans-serif" Margin="4,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedMissionItem.WeatherSummary, FallbackValue='Consultando NOAA...'}" FontSize="12" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedMissionItem.WeatherTooltip}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 3. CALL TO ACTION (CTA) TRAVADO NO RODAPÉ (#00E5FF Ciano Aviônica, Altura 50px) -->
                            <Border Grid.Row="2" Background="#141C24" CornerRadius="8" Padding="10" BorderBrush="#263545" BorderThickness="1">
                                <Button Command="{Binding AcceptSelectedMissionsCommand}" IsEnabled="{Binding CanAcceptMission}" Height="50" Cursor="Hand" Background="#00E5FF" Foreground="#0B0F14" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,0">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="➕ " FontSize="15" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CtaButtonText}" FontSize="15" FontWeight="ExtraBold" Foreground="#0B0F14" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#00B4D8"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#1F2B37"/>
                                                    <Setter Property="Foreground" Value="#526375"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- VIEW: BRIEFING (DISPATCH & PRE-FLIGHT GATE) -->
                <Grid Margin="24,18,24,18" DataContext="{Binding Briefing}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Briefing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- CABEÇALHO TÁTICO -->
                        <RowDefinition Height="*"/>    <!-- GRID DE 3 COLUNAS (30% / 45% / 25%) -->
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO TÁTICO OPERACIONAL -->
                    <Border Grid.Row="0" Background="#141C24" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderBrush="#263545" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Indicador do Voo e Rota Multi-Leg -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0B0F14" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding FlightNumber}" FontSize="18" FontWeight="Black" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DESPACHO OPERACIONAL &amp; PRE-FLIGHT GATE" FontSize="9" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <TextBlock Text="{Binding RouteSummaryDisplay, FallbackValue='SBSJ ➔ SBSP ➔ SDTB'}" FontSize="16" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. Resumo Rápido de Corredor (Distância Total e ETE Total) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DISTÂNCIA TOTAL: " FontSize="10" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalRouteDistanceNM, StringFormat={}{0:N0} NM, FallbackValue='0 NM'}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ETE ESTIMADO: " FontSize="10" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalRouteEteFormatted, FallbackValue='--'}" FontSize="12" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. Status de Conexão com o Simulador e Botão Novo Voo -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{Binding ConnectionModeBg, FallbackValue='#0D2B1E'}" 
                                        BorderBrush="{Binding ConnectionModeBorder, FallbackValue='#00E676'}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConnectionModeIcon, FallbackValue='🟢'}" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ConnectionModeText, FallbackValue='MSFS CONECTADO'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ConnectionModeColor}" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="" Width="32" Height="32" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#00E5FF"
                                        ToolTip="Gerar Novo Número de Voo" Cursor="Hand"
                                        Command="{Binding DataContext.ShowBriefingCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- GRID PRINCIPAL DE 3 COLUNAS: 30% / 45% / 25% -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*"/> <!-- COLUNA 1: MANIFESTO & ROTA MULTI-LEG -->
                            <ColumnDefinition Width="45*"/> <!-- COLUNA 2: MAPA TÁTICO & NAVEGAÇÃO -->
                            <ColumnDefinition Width="25*"/> <!-- COLUNA 3: GATEKEEPER & PLAN VS SIM -->
                        </Grid.ColumnDefinitions>

                        <!-- ======================================================== -->
                        <!-- COLUNA 1 (30%): MANIFESTO, ROTAS & W&B INTEGRADO        -->
                        <!-- ======================================================== -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 1. Itinerário Dinâmico / Pernas -->
                                <RowDefinition Height="*"/>    <!-- 2. Cards das Missões Aceitas -->
                                <RowDefinition Height="Auto"/> <!-- 3. Bloco Unificado de Massa e Centragem (W&B) -->
                            </Grid.RowDefinitions>

                            <!-- 1. TIMELINE DE ROTA / PERNAS COMPACTO -->
                            <Border Grid.Row="0" Background="#141C24" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#263545" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cabeçalho do Itinerário -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🛫 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="ITINERÁRIO DINÂMICO MULTI-LEG" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RouteLegs.Count, StringFormat='{}{0} PERNAS'}" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Lista de Pernas (Legs) -->
                                    <ScrollViewer Grid.Row="1" MaxHeight="135" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RouteLegs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <!-- Cabeçalho da Perna: LEG X: ORIGEM ➔ DESTINO + NM -->
                                                            <Grid Margin="0,0,0,3">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="#1F2B37" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding LegNumber, StringFormat='LEG {0}'}" FontSize="8.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding RouteDisplay}" FontSize="11" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DistanceDisplay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- Detalhes de Carga a Bordo nesta Perna -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                <TextBlock Text="A BORDO: " FontSize="8.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                                <TextBlock Text="{Binding OnboardPax, StringFormat='{}{0} PAX'}" FontSize="8.5" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                <TextBlock Text=" • " FontSize="8.5" Foreground="#526375"/>
                                                                <TextBlock Text="{Binding OnboardCargoLbs, StringFormat='{}{0:N0} LBS CARGA'}" FontSize="8.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                <TextBlock Text=" • " FontSize="8.5" Foreground="#526375"/>
                                                                <TextBlock Text="{Binding EteFormatted, StringFormat='ETE: {0}'}" FontSize="8.5" Foreground="#8B9BAE" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                            </StackPanel>

                                                            <!-- Ação ao Pousar no Destino desta Perna -->
                                                            <Border Background="#141C24" CornerRadius="3" Padding="5,2">
                                                                <TextBlock Text="{Binding ActionSummary}" FontSize="8.5" FontWeight="SemiBold" Foreground="#00E676" FontFamily="Inter, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- 2. CARDS DAS MISSÕES ACEITAS NO MANIFESTO (Com botão Ghost de Remoção) -->
                            <Border Grid.Row="1" Background="#141C24" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#263545" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cabeçalho do Manifesto -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📦 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="CONTRATOS NO MANIFESTO" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AcceptedMissions.Count, StringFormat='{}{0} ATIVOS'}" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Lista de Cards Compactos por Missão com Botão de Exclusão Ghost -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AcceptedMissions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Detalhes do Contrato -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                    <TextBlock Text="{Binding DestinationICAO}" FontSize="12" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                    <TextBlock Text=" • " FontSize="10" Foreground="#526375" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Title}" FontSize="10" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PassengerCount, StringFormat='{}{0} PAX'}" FontSize="9" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                    <TextBlock Text=" • " FontSize="9" Foreground="#526375"/>
                                                                    <TextBlock Text="{Binding PayloadLbs, StringFormat='{}{0:N0} LBS'}" FontSize="9" FontWeight="SemiBold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                    <TextBlock Text=" • " FontSize="9" Foreground="#526375"/>
                                                                    <TextBlock Text="{Binding RewardMoney, StringFormat=C0}" FontSize="9" FontWeight="Bold" Foreground="#00E676" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Botão Outline / Ghost de Remoção de Contrato -->
                                                            <Button Grid.Column="1" Command="{Binding DataContext.RemoveMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="22" Height="22" Background="Transparent" BorderBrush="#263545" BorderThickness="1" Cursor="Hand" ToolTip="Remover contrato e retornar ao mercado" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                                            <TextBlock x:Name="btnTxt" Text="✕" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="btnBorder" Property="Background" Value="#2E1214"/>
                                                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#EF4444"/>
                                                                                <Setter TargetName="btnTxt" Property="Foreground" Value="#EF4444"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- 3. BLOCO DEDICADO DE MASSA & CENTRAGEM (W&B) E ENVELOPE DE MTOW -->
                            <Border Grid.Row="2" Background="#141C24" CornerRadius="8" Padding="12,10" BorderBrush="#263545" BorderThickness="1">
                                <StackPanel>
                                    <!-- Header do W&B com Margem Livre -->
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚖️ " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="ENVELOPE DE MASSA &amp; BALANCEAMENTO" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{Binding TowMarginBadgeBg}" BorderBrush="{Binding TowMarginBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding TowMarginDisplay}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding TowEnvelopeColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </Border>
                                    </Grid>

                                    <!-- Barra Visual de Limite MTOW -->
                                    <Border Background="#0B0F14" BorderBrush="#1F2D3D" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="TOW: " FontSize="8.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                    <TextBlock Text="{Binding CalculatedTotalWeight, StringFormat={}{0:N0} lbs}" FontSize="11" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="MTOW: " FontSize="8.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                    <TextBlock Text="{Binding HangarAircraftMtow, StringFormat={}{0:N0} lbs}" FontSize="10" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    <TextBlock Text=" • " FontSize="9" Foreground="#526375"/>
                                                    <TextBlock Text="{Binding TowPercentage, StringFormat={}{0:F0}%}" FontSize="10" FontWeight="Bold" Foreground="{Binding TowEnvelopeColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Value="{Binding TowPercentage, Mode=OneWay}" Maximum="100" Height="6" Background="#101722" Foreground="{Binding TowEnvelopeColor}" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Distribuição Detalhada de Peso (Assentos, Carga, Combustível) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Assentos -->
                                        <Border Grid.Column="0" Background="#0B0F14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="💺 ASSENTOS" FontSize="8" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding TotalSeatsWeight, StringFormat={}{0:N0} lbs}" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding TotalOccupantsCount, StringFormat='{}{0} ocup.'}" FontSize="7.5" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carga / Bagagem -->
                                        <Border Grid.Column="1" Background="#0B0F14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="📦 CARGA" FontSize="8" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding TotalCargoWeight, StringFormat={}{0:N0} lbs}" FontSize="10.5" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,1,0,0"/>
                                                <TextBlock Text="Bagagem/Pax" FontSize="7.5" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Combustível -->
                                        <Border Grid.Column="2" Background="#0B0F14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="⛽ TANQUES" FontSize="8" FontWeight="SemiBold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding FuelQuantity, StringFormat={}{0:F1} gal}" FontSize="10.5" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding FuelWeightLbs, StringFormat='{}{0:N0} lbs'}" FontSize="7.5" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Guia Rápido de Abas do EFB (MSFS 2024) -->
                                    <Border Background="#0E1622" BorderBrush="#1F2D3D" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding MsfsSeatsGuideDisplay, StringFormat='↳ Aba Assentos: {0}'}" FontSize="8" FontWeight="SemiBold" Foreground="#94A3B8" FontFamily="JetBrains Mono, monospace" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding MsfsCargoGuideDisplay, StringFormat='↳ Aba Carga: {0}'}" FontSize="8" FontWeight="SemiBold" Foreground="#94A3B8" FontFamily="JetBrains Mono, monospace" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ======================================================== -->
                        <!-- COLUNA 2 (45%): MAPA TÁTICO & NAVEGAÇÃO LIMPO            -->
                        <!-- ======================================================== -->
                        <Grid Grid.Column="1" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#141C24" CornerRadius="8" ClipToBounds="True" BorderBrush="#263545" BorderThickness="1">
                                <utils:FlightMapControl AircraftLat="{Binding Latitude}" 
                                                        AircraftLon="{Binding Longitude}"
                                                        RouteLegs="{Binding RouteLegs}"
                                                        DestLat="{Binding DestLat}" 
                                                        DestLon="{Binding DestLon}"
                                                        OriginIcao="{Binding HangarAircraftLocation}"
                                                        DestIcao="{Binding FlightDestination}"
                                                        IsOnGround="{Binding IsOnGround}"
                                                        AircraftHeading="{Binding AircraftHeading}"
                                                        Altitude="{Binding Altitude}"
                                                        GroundSpeed="{Binding GroundSpeed}"/>
                            </Border>
                        </Grid>

                        <!-- ======================================================== -->
                        <!-- COLUNA 3 (25%): GATEKEEPER & AUDITORIA (PLAN VS SIM)     -->
                        <!-- ======================================================== -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Card da Aeronave -->
                                <RowDefinition Height="*"/>    <!-- Checklist Pre-Flight Sync (Plan vs Sim) -->
                                <RowDefinition Height="Auto"/> <!-- Ações e Botão Mestre -->
                            </Grid.RowDefinitions>

                            <!-- 1. CARD DA AERONAVE ATIVA NO HANGAR -->
                            <Border Grid.Row="0" Background="#141C24" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#263545" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="AERONAVE DESIGNADA" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif"/>
                                        <TextBlock Text="{Binding HangarAircraftPrefix}" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                    </Grid>
                                    <TextBlock Text="{Binding HangarAircraftModel}" FontSize="13" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Inter, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="BASE: " FontSize="8" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding HangarAircraftLocation}" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="TANQUES: " FontSize="8" Foreground="#8B9BAE"/>
                                            <TextBlock Text="{Binding HangarAircraftFuel, StringFormat={}{0:F1} GAL}" FontSize="9" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. COMPONENTE PRE-FLIGHT GATEKEEPER COM COMPARAÇÃO 2-COLUNAS -->
                            <Border Grid.Row="1" Background="#141C24" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#263545" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cabeçalho Centralizado do Gatekeeper com Badge Consolidada -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️ " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="PRE-FLIGHT GATEKEEPER" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{Binding GatekeeperSummaryBadgeBg}" BorderBrush="{Binding GatekeeperSummaryBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GatekeeperSummaryIcon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding GatekeeperSummaryText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding GatekeeperSummaryTextColor}" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Lista de Comparação Bidirecional de Alta Legibilidade (Plan vs. Sim) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ChecklistItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <!-- Linha 1: Nome do Parâmetro + Badge de Status -->
                                                            <Grid Margin="0,0,0,5">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ItemIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ParameterName}" FontSize="10" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border HorizontalAlignment="Right" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="8" FontWeight="ExtraBold" Foreground="{Binding StatusColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Box de Comparação Técnica 2-Colunas (Plano vs. Sim) -->
                                                            <Border Background="#101722" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="1"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Coluna Plano -->
                                                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                        <TextBlock Text="PLANO" FontSize="7.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                                        <TextBlock Text="{Binding CleanPlanned}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>

                                                                    <!-- Divisor Vertical -->
                                                                    <Border Grid.Column="1" Background="#1E293B" Margin="0,1"/>

                                                                    <!-- Coluna Simulado -->
                                                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                                        <Grid>
                                                                            <TextBlock Text="SIMULADOR" FontSize="7.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                                            <TextBlock Text="{Binding ToleranceBadge}" FontSize="7.5" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding CleanSim}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" FontFamily="JetBrains Mono, Consolas, monospace" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Explicação / Orientação em caso de Divergência -->
                                                            <Border Background="{Binding ExplanationBg}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,5,0,0"
                                                                    Visibility="{Binding IsOk, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Explanation}" FontSize="9" Foreground="{Binding ExplanationColor}" FontFamily="Inter, Segoe UI, sans-serif" TextWrapping="Wrap" LineHeight="13"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- 3. AÇÕES CONTEXTUAIS & BOTÃO MESTRE (Com Respiro de Margem Inferior) -->
                            <Border Grid.Row="2" Background="#141C24" CornerRadius="8" Padding="12,12" Margin="0,0,0,16" BorderBrush="#263545" BorderThickness="1">
                                <StackPanel>
                                    <!-- Botão Contextual de Cópia / Confirmação de Sincronia de W&B -->
                                    <Button Command="{Binding CopyPreFlightWeightsCommand}" Height="34" 
                                            Background="{Binding CopyWandBButtonBg}" 
                                            BorderBrush="{Binding CopyWandBButtonBorder}" 
                                            BorderThickness="1" Cursor="Hand" Margin="0,0,0,10"
                                            ToolTip="Copia os dados de Payload e Combustível para a Área de Transferência">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CopyWandBButtonText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding CopyWandBButtonColor}" FontFamily="JetBrains Mono, Consolas, monospace" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Botão Mestre de Liberação (Gatekeeper Release Button) -->
                                    <Button Command="{Binding DataContext.StartFlightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsEnabled="{Binding CanStartFlightOrCancel}"
                                            Height="48" Cursor="Hand"
                                            Background="{Binding DataContext.StartFlightButtonColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="{Binding GatekeeperBlockedReason}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🚀 " FontSize="14" VerticalAlignment="Center"
                                                                       Visibility="{Binding DataContext.IsMonitoring, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding DataContext.StartFlightButtonText, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                       FontSize="13" FontWeight="ExtraBold" Foreground="White" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#1A232E"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#263545"/>
                                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                                        <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- VIEW: FINANCEIRO -->
                <Grid Margin="30" DataContext="{Binding Finance}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Finance">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock Text="Financeiro" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Controle de entradas e saídas da companhia" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,30">
                        <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL RECEBIDO" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding TotalIncome, StringFormat=C}" FontSize="20" FontWeight="Bold" Foreground="#2ECC71"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL GASTO" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding TotalExpenses, StringFormat=C}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LUCRO LÍQUIDO" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding NetProfit, StringFormat=C}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="15" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="HISTÓRICO DE TRANSAÇÕES" FontSize="14" FontWeight="Bold" Margin="15,15,15,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATA" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                                    <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="VALOR" Binding="{Binding Amount, StringFormat=C}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Income">
                                                        <Setter Property="Foreground" Value="#2ECC71"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW: MERCADO -->
                <Grid Margin="30" DataContext="{Binding Market}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Market">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mercado de Usados" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" CornerRadius="12" Padding="10,2" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Offers.Count, StringFormat={}{0} aeronaves}" FontSize="12" FontWeight="SemiBold" Foreground="#00E5FF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Catálogo dinâmico de aeronaves à venda com cotação de mercado e inspeção técnica" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Campo de Busca de Aeronaves -->
                        <Border Grid.Column="1" Background="#141C24" BorderBrush="#263545" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Width="300">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="12" Foreground="#8B9BAE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         Foreground="#F0F4F8" 
                                         BorderThickness="0" 
                                         FontSize="13" 
                                         VerticalAlignment="Center" 
                                         CaretBrush="#00E5FF"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" 
                                 ItemsSource="{Binding Offers}" 
                                 SelectedItem="{Binding SelectedOffer}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Background="{StaticResource CardBackground}" Margin="0,0,0,10" CornerRadius="12" Padding="20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding BaseType.Model}" FontSize="18" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="{Binding Prefix}" FontSize="14" Foreground="{StaticResource PrimaryBlue}" Margin="15,0,0,0" VerticalAlignment="Bottom" Opacity="0.8"/>
                                            </StackPanel>
                    
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="CONDIÇÃO GERAL: " FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding AverageCondition, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Black" Foreground="{Binding StateColor}"/>
                                                <TextBlock Text=" • " Foreground="#2D3033" Margin="5,0"/>
                                                <TextBlock Text="{Binding AirframeHours, StringFormat={}{0:N0}h}" FontSize="10" Foreground="White" Opacity="0.7" VerticalAlignment="Center"/>
                                                <TextBlock Text=" • " Foreground="#2D3033" Margin="5,0"/>
                                                <TextBlock Text="{Binding FuelAmount, StringFormat={}{0:F1} GAL}" FontSize="10" Foreground="#F1C40F" VerticalAlignment="Center"/>
                                            </StackPanel>
                    
                                            <TextBlock Text="{Binding SalePrice, StringFormat=C}" FontSize="20" FontWeight="Black" Foreground="#2ECC71" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="#2D3033"/>
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter TargetName="card" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="1" Background="{StaticResource SurfaceDark}" CornerRadius="15" Margin="20,0,0,0" Padding="25">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedOffer.BaseType.Model}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SelectedOffer.Prefix}" FontSize="16" Foreground="{StaticResource PrimaryBlue}" Margin="0,5,0,20"/>

                                <UniformGrid Columns="2" Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="TIPO" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.BaseType.Type}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="TTAF (HORAS TOTAIS)" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.AirframeHours, StringFormat={}{0:N0}h}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="ALCANCE" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.BaseType.RangeNM, StringFormat={}{0:N0} NM}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="VEL. CRUZEIRO" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.BaseType.CruiseSpeedKts, StringFormat={}{0} KTS}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="CARGA MÁX" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.BaseType.MaxPayloadLbs, StringFormat={}{0:N0} LBS}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="MAX PAX" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.BaseType.MaxPax, StringFormat={}{0} PAX}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="PISTA MÍNIMA" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.BaseType.MinRunwayLength, StringFormat={}{0:N0} FT}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="COMBUSTÍVEL" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedOffer.FuelAmount, StringFormat={}{0:F1} GAL}" FontSize="13" FontWeight="Bold" Foreground="#F1C40F"/>
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="CONSUMO" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding SelectedOffer.BaseType.FuelConsumptionGPH, StringFormat={}{0:F1} GPH}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>

                                <Separator Background="#2D3033" Margin="0,0,0,20"/>

                                <TextBlock Text="CONDIÇÃO GERAL" FontSize="10" Margin="0,0,0,5"/>
                                <ProgressBar Height="6" Value="{Binding SelectedOffer.AverageCondition, Mode=OneWay}" Foreground="{StaticResource PrimaryBlue}" Background="#1A1C1E" BorderThickness="0"/>
                                <TextBlock Text="{Binding SelectedOffer.GeneralState}" FontSize="10" FontWeight="Bold" Foreground="{Binding SelectedOffer.StateColor}" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                
                                <Button Command="{Binding BuyCommand}" Content="{Binding BuyButtonText}" Height="55" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Bold" Margin="0,40,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#0086D1"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW: HANGAR -->
                <Grid Margin="0" DataContext="{Binding Hangar}">
                    <Grid.Resources>
                        <!-- Cores do Tema HTML -->
                        <SolidColorBrush x:Key="BgDarker" Color="#0F172A"/>
                        <SolidColorBrush x:Key="BgMain" Color="#1E293B"/>
                        <SolidColorBrush x:Key="CardBg" Color="#334155"/>
                        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
                        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
                        <SolidColorBrush x:Key="BorderColor" Color="#475569"/>
                        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
                        <SolidColorBrush x:Key="SuccessGreen" Color="#22C55E"/>
                        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
                        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>

                        <!-- Estilo para os Cards -->
                        <Style x:Key="HangarCard" TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource CardBg}"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="25"/>
                            <Setter Property="Margin" Value="0,0,0,20"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Hangar">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid Background="{StaticResource BgMain}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SIDEBAR: LISTA DE AERONAVES -->
                        <Grid Grid.Column="0" Background="{StaticResource BgDarker}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20">
                                <TextBlock Text="Minha Frota" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Fleet}" SelectedItem="{Binding SelectedAircraft}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Padding="15,20" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="Transparent" Cursor="Hand">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Prefix}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                                <TextBlock Text="-" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                            </StackPanel>
                                                            
                                                            <Border Grid.Column="1" Background="{StaticResource SuccessGreen}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="ATIVA" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardBg}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="4,0,0,1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>

                        <!-- ÁREA PRINCIPAL -->
                        <Grid Grid.Column="1" Margin="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER DA AERONAVE -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,20">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SelectedAircraft.Prefix}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                <TextBlock Text=" | " FontSize="32" Foreground="{StaticResource BorderColor}" Margin="10,0"/>
                                                <TextBlock Text="{Binding SelectedAircraft.Model}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                            </StackPanel>

                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="15,8" Command="{Binding SetActiveCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                                        <Setter Property="Content" Value="Definir como Ativa"/>
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Content" Value="Aeronave Selecionada para Voo"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <WrapPanel Margin="0,15,0,0">
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="PAX: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.MaxPax}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="MOTOR: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.EngineType}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="VELOCIDADE: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.CruiseSpeedKts, StringFormat={}{0} KT}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ALCANCE: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.Aircraft.AircraftType.RangeNM, StringFormat={}{0} NM}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="MTOW: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.MTOW, StringFormat={}{0:N0} LBS}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                                                                        <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="COMBUSTÍVEL: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.FuelCapacity, StringFormat={}{0:F0} GAL}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.FuelType, StringFormat=({0})}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="TBO: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.EngineTboRemainingHours, StringFormat={}{0:F0}h}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgDarker}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="CABINE: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.Configuration}" Foreground="{StaticResource PrimaryBlue}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{Binding SelectedAircraft.StatusColor}" CornerRadius="6" Padding="12,6">
                                                <TextBlock Text="{Binding SelectedAircraft.StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                                                        <!-- DASHBOARD GRID -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <UniformGrid Columns="2">
                                    <!-- CARD: MANUTENÇÃO CORRETIVA -->
                                    <Border Style="{StaticResource HangarCard}" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="🛠️ Manutenção e Reparos" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                                            <StackPanel Margin="0,0,0,20">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Motor" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.TargetEngineCondition, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedAircraft.TargetEngineCondition}" Foreground="{StaticResource PrimaryBlue}"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,20">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Fuselagem" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.TargetAirframeCondition, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedAircraft.TargetAirframeCondition}" Foreground="{StaticResource PrimaryBlue}"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,20">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Pneus" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.TargetTiresCondition, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedAircraft.TargetTiresCondition}" Foreground="{StaticResource PrimaryBlue}"/>
                                            </StackPanel>

                                            <Button Content="Aplicar Reparos" Command="{Binding AuthorizeServicesCommand}" Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Height="45" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD: MANUTENÇÃO REGULATÓRIA & TBO -->
                                    <Border Style="{StaticResource HangarCard}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="📋 Inspeções Regulatórias &amp; TBO" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

                                            <!-- TBO Motor -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="TBO Restante do Motor:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.EngineTboRemainingHours, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                </StackPanel>
                                                <Button Content="Retífica TBO" Command="{Binding PerformOverhaulCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Style="{StaticResource NavButton}" Background="#D97706" Foreground="White" Height="32" Padding="12,0" FontSize="11"
                                                        ToolTip="Restaura motor a 100% e TBO para 1.800h"/>
                                            </Grid>

                                            <!-- Inspeção 50 Horas -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="Próxima Inspeção 50h:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.HoursUntilNext50hInspection, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                </StackPanel>
                                                <Button Content="Fazer 50h ($850)" Command="{Binding Perform50hInspectionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="32" Padding="12,0" FontSize="11"/>
                                            </Grid>

                                            <!-- Inspeção 100 Horas -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="Próxima Inspeção 100h (Obrigatória):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.HoursUntilNext100hInspection, StringFormat={}{0:F1}h restantes}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                </StackPanel>
                                                <Button Content="Fazer 100h ($2.500)" Command="{Binding Perform100hInspectionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="32" Padding="12,0" FontSize="11"/>
                                            </Grid>

                                            <!-- Configuração de Cabine (Pax vs Carga) -->
                                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,5,0,0">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="Configuração da Cabine:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding SelectedAircraft.Configuration}" Foreground="{StaticResource PrimaryBlue}" FontWeight="Bold" FontSize="13"/>
                                                    </StackPanel>
                                                    <Button Content="Converter ($1.200)" Command="{Binding ToggleConfigurationCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Style="{StaticResource NavButton}" Background="#374151" Foreground="White" Height="32" Padding="12,0" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD: ABASTECIMENTO -->
                                    <Border Style="{StaticResource HangarCard}" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="⛽ Abastecimento" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="Combustível:" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding SelectedAircraft.FuelType}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="Preço por Galão:" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding SelectedAircraft.FuelPricePerGallon, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,20">
                                                <TextBlock Text="Nível Atual:" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding SelectedAircraft.Aircraft.FuelAmount, StringFormat={}{0:F1} gal}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                            </Grid>

                                            <StackPanel Margin="0,20,0,0">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Abastecer até:" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedAircraft.TargetFuel, StringFormat={}{0:F1} gal}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}"/>
                                                </Grid>
                                                <Slider Minimum="{Binding SelectedAircraft.Aircraft.FuelAmount}" Maximum="{Binding SelectedAircraft.FuelCapacity}" Value="{Binding SelectedAircraft.TargetFuel}" Foreground="{StaticResource PrimaryBlue}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding SelectedAircraft.RefuelCost, StringFormat={}Custo: {0:C2}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Right" Margin="0,20,0,15"/>
                                            
                                            <Button Content="Confirmar Abastecimento" Command="{Binding AuthorizeServicesCommand}" Style="{StaticResource NavButton}" Background="{StaticResource PrimaryBlue}" Height="45" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD: SEGURO -->
                                    <Border Style="{StaticResource HangarCard}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="🛡️ Seguro da Aeronave" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,15"/>
                                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                                            <Grid Margin="0,0,0,20">
                                                <TextBlock Text="Status da Apólice:" Foreground="{StaticResource TextMuted}"/>
                                                <Border HorizontalAlignment="Right" CornerRadius="5" Padding="10,5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource DangerRed}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="True">
                                                                        <Setter Property="Text" Value="ATIVO"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="False">
                                                                        <Setter Property="Text" Value="INATIVO"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="Prêmio Mensal:" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding SelectedAircraft.InsurancePremium, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="Valor do Casco (Payout):" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding SelectedAircraft.InsurancePayout, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,25">
                                                <TextBlock Text="Franquia:" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding SelectedAircraft.InsuranceDeductible, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Foreground="{StaticResource TextMain}" FontWeight="Bold"/>
                                            </Grid>

                                            <Button Command="{Binding BuyInsuranceCommand}" Height="45" FontWeight="Bold">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="True">
                                                                <Setter Property="Content" Value="Seguro Contratado"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedAircraft.IsInsured}" Value="False">
                                                                <Setter Property="Content" Value="Contratar Seguro"/>
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </ScrollViewer>

                            <!-- OVERLAY DE PERDA TOTAL (CRASH) -->
                            <Border Grid.Row="1" Background="#CC0F172A" CornerRadius="12" Visibility="{Binding SelectedAircraft.IsCrashed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⚠ PERDA TOTAL DETECTADA" FontSize="36" FontWeight="Black" Foreground="{StaticResource DangerRed}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="A aeronave sofreu danos estruturais irreparáveis. O seguro deve ser acionado." FontSize="16" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,30"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding ClaimInsuranceCommand}" Content="ACIONAR SEGURO" Style="{StaticResource NavButton}" Background="{StaticResource SuccessGreen}" Foreground="White" FontWeight="Bold" Padding="30,15" Margin="0,0,20,0"/>
                                        <Button Command="{Binding ScrapAircraftCommand}" Content="DESCARTAR AERONAVE" Style="{StaticResource NavButton}" Background="{StaticResource DangerRed}" Foreground="White" FontWeight="Bold" Padding="30,15"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- VIEW: LOGS DE VOO / BLACKBOX & TELEMETRIA -->
                <Grid Margin="24,18,24,18" DataContext="{Binding FlightLogs}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="FlightLogs">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- CABEÇALHO -->
                        <RowDefinition Height="*"/>    <!-- CORPO SPLIT-SCREEN (32% / 68%) -->
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO DA TELA DE LOGS -->
                    <Border Grid.Row="0" Background="#141C24" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderBrush="#263545" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Diário de Bordo &amp; Blackbox" FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Inter, Segoe UI, sans-serif"/>
                                    <Border Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalFlightsCount, StringFormat='{}{0} voos gravados'}" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Histórico completo de telemetria gravada segundo a segundo com reconstituição de rota em mapa" FontSize="11" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Campo de Busca -->
                                <Border Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" Width="200">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                </Border>

                                <Button Command="{Binding RefreshLogsCommand}" Height="34" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#00E5FF" Cursor="Hand" Padding="10,0" Margin="0,0,8,0" ToolTip="Atualizar lista de logs">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔄 " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ATUALIZAR" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Command="{Binding OpenLogsFolderCommand}" Height="34" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#F0F4F8" Cursor="Hand" Padding="10,0" ToolTip="Abrir pasta de arquivos no Windows Explorer">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📂 " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="PASTA DE LOGS" FontSize="10" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CORPO SPLIT-SCREEN -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32*"/> <!-- LISTA DE VOOS -->
                            <ColumnDefinition Width="68*"/> <!-- DETALHES + MAPA + TELEMETRIA -->
                        </Grid.ColumnDefinitions>

                        <!-- PAINEL ESQUERDO: LISTA DE VOOS GRAVADOS -->
                        <Border Grid.Column="0" Background="#141C24" CornerRadius="8" Padding="12" Margin="0,0,10,0" BorderBrush="#263545" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="MISSÕES &amp; VOOS ARQUIVADOS" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,0,0,10"/>

                                <ListBox Grid.Row="1" ItemsSource="{Binding FlightLogs}" SelectedItem="{Binding SelectedLog}" 
                                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="10,8" Cursor="Hand">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A2836"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Linha 1: Rota e Badge de Status -->
                                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding RouteDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    <Border HorizontalAlignment="Right" Background="{Binding StatusBg}" CornerRadius="3" Padding="5,1">
                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Linha 2: Aeronave e Data -->
                                                <Grid Grid.Row="1" Margin="0,0,0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✈ " FontSize="9" Foreground="#8B9BAE" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Aircraft}" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DateFormatted}" HorizontalAlignment="Right" FontSize="9.5" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                </Grid>

                                                <!-- Linha 3: Duração e Rating -->
                                                <Grid Grid.Row="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Duração: " FontSize="9" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding DurationFormatted}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding QualityRating}" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="{Binding QualityColor}" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- PAINEL DIREITO: DETALHES COMPLETOS, MAPA DE ROTA E TELEMETRIA -->
                        <Border Grid.Column="1" Background="#141C24" CornerRadius="8" Padding="14" BorderBrush="#263545" BorderThickness="1">
                            <Grid>
                                <!-- Se nenhum voo selecionado -->
                                <Border Background="#0B0F14" CornerRadius="8" Padding="30"
                                        Visibility="{Binding HasSelectedLog, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="NENHUM VOO SELECIONADO" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Selecione um voo da lista à esquerda para analisar a telemetria gravada e visualizar o traçado de rota no mapa." FontSize="11" Foreground="#8B9BAE" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Se voo selecionado -->
                                <Grid Visibility="{Binding HasSelectedLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- KPIs / Banner Superior -->
                                        <RowDefinition Height="1.2*"/> <!-- Mapa de Trajetória Interativo -->
                                        <RowDefinition Height="1.0*"/> <!-- Tabela de Telemetria Blackbox -->
                                        <RowDefinition Height="Auto"/> <!-- Barra de Ações Inferior -->
                                    </Grid.RowDefinitions>

                                    <!-- 1. KPIS E BANNER DE PERFORMANCE -->
                                    <Border Grid.Row="0" Background="#0B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Identificação Principal -->
                                            <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedLog.RouteDisplay}" FontSize="16" FontWeight="Black" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    <Border Background="{Binding SelectedLog.StatusBg}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedLog.StatusDisplay}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedLog.StatusColor}" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedLog.DateFormatted}" FontSize="10" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Métricas Rápidas (UniformGrid) -->
                                            <UniformGrid Grid.Column="1" Columns="5" VerticalAlignment="Center">
                                                <Border Background="#141C24" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel>
                                                        <TextBlock Text="DURAÇÃO" FontSize="8" FontWeight="Bold" Foreground="#8B9BAE"/>
                                                        <TextBlock Text="{Binding SelectedLog.DurationFormatted}" FontSize="11" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#141C24" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel>
                                                        <TextBlock Text="TOUCHDOWN" FontSize="8" FontWeight="Bold" Foreground="#8B9BAE"/>
                                                        <TextBlock Text="{Binding SelectedLog.TouchdownDisplay}" FontSize="11" FontWeight="Bold" Foreground="#00E676" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#141C24" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel>
                                                        <TextBlock Text="QUALIDADE" FontSize="8" FontWeight="Bold" Foreground="#8B9BAE"/>
                                                        <TextBlock Text="{Binding SelectedLog.QualityRating}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedLog.QualityColor}" FontFamily="Inter, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#141C24" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel>
                                                        <TextBlock Text="FORÇA G" FontSize="8" FontWeight="Bold" Foreground="#8B9BAE"/>
                                                        <TextBlock Text="{Binding SelectedLog.GForceRange}" FontSize="11" FontWeight="Bold" Foreground="#FFB300" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#141C24" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel>
                                                        <TextBlock Text="ALTITUDE MÁX" FontSize="8" FontWeight="Bold" Foreground="#8B9BAE"/>
                                                        <TextBlock Text="{Binding SelectedLog.MaxAltitudeFt, StringFormat={}{0:N0} FT}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

                                    <!-- 2. MAPA DE TRAJETÓRIA REAL (ROTA DE TELEMETRIA) -->
                                    <Border Grid.Row="1" Background="#0B0F14" CornerRadius="6" ClipToBounds="True" BorderBrush="#263545" BorderThickness="1" Margin="0,0,0,10">
                                        <Grid>
                                            <utils:FlightMapControl RecordedPath="{Binding SelectedLog.MapRoutePoints}"
                                                                    OriginIcao="{Binding SelectedLog.OriginICAO}"
                                                                    DestIcao="{Binding SelectedLog.DestinationICAO}"/>
                                            
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E60B0F14" BorderBrush="#263545" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗺️ TRAJETÓRIA REAL DE VOO • " FontSize="9" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                    <TextBlock Text="{Binding SelectedLog.MapRoutePoints.Count, StringFormat='{}{0} PONTOS GPS'}" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 3. TABELA DE TELEMETRIA BLACKBOX SEGUNDO A SEGUNDO -->
                                    <Border Grid.Row="2" Background="#0B0F14" CornerRadius="6" BorderBrush="#263545" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="4,0,4,6">
                                                <TextBlock Text="REGISTRO DETALHADO DE TELEMETRIA (AMOSTRAGEM 2s)" FontSize="9" FontWeight="Bold" Foreground="#8B9BAE" FontFamily="Inter, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding SelectedLog.TelemetryRecords.Count, StringFormat='{}{0} REGISTROS'}" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace"/>
                                            </Grid>

                                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedLog.TelemetryRecords}"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#081018"
                                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A2836"
                                                      HeadersVisibility="Column" Foreground="#F0F4F8" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="10">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#141C24"/>
                                                        <Setter Property="Foreground" Value="#8B9BAE"/>
                                                        <Setter Property="FontSize" Value="9"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Padding" Value="6,4"/>
                                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                        <Setter Property="BorderBrush" Value="#263545"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="TEMPO" Binding="{Binding ElapsedFormatted}" Width="65"/>
                                                    <DataGridTextColumn Header="ALT (FT)" Binding="{Binding AltitudeFt, StringFormat={}{0:N0}}" Width="70"/>
                                                    <DataGridTextColumn Header="GS (KT)" Binding="{Binding GroundSpeedKt, StringFormat={}{0:N0}}" Width="65"/>
                                                    <DataGridTextColumn Header="VS (FPM)" Binding="{Binding VerticalSpeedFpm, StringFormat={}{0:N0}}" Width="75"/>
                                                    <DataGridTextColumn Header="G-FORCE" Binding="{Binding GForce, StringFormat={}{0:F2}}" Width="65"/>
                                                    <DataGridTextColumn Header="RPM" Binding="{Binding EngineRPM, StringFormat={}{0:N0}}" Width="65"/>
                                                    <DataGridTextColumn Header="COMB (GAL)" Binding="{Binding FuelGallons, StringFormat={}{0:F1}}" Width="75"/>
                                                    <DataGridTextColumn Header="FASE / STATUS" Binding="{Binding Status}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- 4. BARRA DE AÇÕES INFERIOR -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Arquivo: " FontSize="10" Foreground="#64748B" FontFamily="Inter, Segoe UI, sans-serif"/>
                                            <TextBlock Text="{Binding SelectedLog.FileName}" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF" FontFamily="JetBrains Mono, Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Command="{Binding OpenCsvFileCommand}" Height="32" Background="#1F2B37" BorderBrush="#00E5FF" BorderThickness="1" Foreground="#00E5FF" Cursor="Hand" Padding="12,0" Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📊 " FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Text="ABRIR NO EXCEL (CSV)" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Command="{Binding OpenLogsFolderCommand}" Height="32" Background="#1F2B37" BorderBrush="#263545" BorderThickness="1" Foreground="#F0F4F8" Cursor="Hand" Padding="12,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📂 " FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Text="ABRIR PASTA" FontSize="10" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Inter, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>