{
  // Catálogo de componentes do FlightCareer V6 (sistema de desgaste e falhas por componente).
  // Regra central: o desgaste natural consome ~70% ao longo da vida útil (chega a ~30% no fim da vida).
  // Só abuso (faixas amarela/vermelha), manutenção vencida ou eventos levam abaixo do limiar de pane (20%).
  //
  // "effect" de cada modo de falha = o que acontece no simulador (ver FailureEffect no domínio):
  //   None, EngineFailure, EngineFire, OilLeak (effectValue = %/min), MagnetoLeft, MagnetoRight,
  //   AlternatorOff, ElectricalFailure, VacuumFailure, PitotBlockage, StaticBlockage, FlapJam,
  //   BrakeFailureOneSide, BrakeFailureTotal, HydraulicFailure
  // "damage" = dano imediato em % quando a pane acontece (no próprio componente ou em "damageKind").

  "hazard": {
    "threshold": 20.0,          // Acima disto: só desgaste, nunca pane por desgaste
    "lambdaAtThreshold": 0.02,  // Falhas/hora em 20%  (~2% de chance numa hora de voo)
    "lambdaAtZero": 2.0         // Falhas/hora em 0%   (~86% de chance numa hora de voo)
  },
  "visibility": {
    "maxHalfWidth": 25.0,       // Faixa máxima exibida: ±25%
    "growthPerHour": 0.4,       // +2% de incerteza a cada 5 h desde a última inspeção
    "walkaroundHalfWidth": 10.0,
    "maxBias": 0.6
  },
  "symptomThreshold": 30.0,
  "overdueMultiplier": 3.0,

  "landing": {
    "hardLandingFpm": 400.0,
    "severeLandingFpm": 600.0,
    "lateralLimitFps": 5.0,
    "gearDamagePer100Fpm": 1.5,
    "tireDamagePer100Fpm": 2.0,
    "gearSevereDamagePer100Fpm": 5.0,
    "airframeSevereDamagePer100Fpm": 2.0,
    "gearLateralDamagePerFps": 1.2,
    "tireLateralDamagePerFps": 1.5,
    "brakeEnergyLossPerHour": 72.0,
    "wetSurfaceMultiplier": 1.8,
    "oilLeakMinFpm": 650.0,           // Pouso duro pode trincar cárter / retentor do virabrequim
    "oilLeakChanceAt1000Fpm": 0.5,
    "oilLeakRatePerMin": 3.5
  },

  // Limites padrão por classe de motor (sobrescritos por modelo em "aircraftOverrides")
  "engineLimits": {
    "Piston": {
      "redlineRpm": 2700, "rpmRedMargin": 0.02,
      "maxCht": 260, "chtCautionMargin": 20,
      "shockCoolingCaution": 28, "shockCoolingRed": 50,
      "maxOilTemp": 118, "oilTempCautionMargin": 8,
      "minOilPressure": 20, "minOilTempForHighPower": 38, "highPowerThrottlePercent": 75,
      "maxStarterSeconds": 30
    },
    "Turboprop": {
      "maxOilTemp": 110, "oilTempCautionMargin": 10,
      "minOilPressure": 60, "minOilTempForHighPower": 10, "highPowerThrottlePercent": 85,
      "maxItt": 805, "ittCautionMargin": 40, "maxStartItt": 1000,
      "maxTorque": 100, "torqueRedMargin": 5, "maxN1": 101.5,
      "maxStarterSeconds": 60
    },
    "Jet": {
      "maxOilTemp": 140, "oilTempCautionMargin": 15,
      "minOilPressure": 25, "minOilTempForHighPower": 0, "highPowerThrottlePercent": 90,
      "maxItt": 900, "ittCautionMargin": 40, "maxStartItt": 950,
      "maxTorque": 100, "torqueRedMargin": 5, "maxN1": 101.5,
      "maxStarterSeconds": 60
    }
  },

  "airframeLimits": {
    "maxG": 3.8,               // Categoria normal (FAR 23)
    "minG": -1.52,
    "gCautionFraction": 0.85,
    "structuralIceCautionPct": 10.0
  },

  // Ajustes por modelo (o primeiro "match" encontrado no nome do modelo vence)
  "aircraftOverrides": [
    {
      "match": [ "C152" ],
      "engineLimits": { "redlineRpm": 2550 },
      "airframeLimits": { "maxG": 4.4, "minG": -1.76 }   // Categoria utilidade
    },
    {
      "match": [ "A320", "A321", "A310", "A330", "A400M", "737", "747", "787", "ATR 42", "ATR 72" ],
      "airframeLimits": { "maxG": 2.5, "minG": -1.0 }    // Categoria transporte (FAR 25)
    },
    {
      "match": [ "DA40NG", "DA62" ],
      "engineClass": "Piston"                             // Diesel abastecido com Jet A-1
    }
  ],

